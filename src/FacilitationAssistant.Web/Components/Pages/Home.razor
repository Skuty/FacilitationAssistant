@page "/"
@rendermode InteractiveServer
@using FacilitationAssistant.Core.Commands
@using MediatR
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Facilitation Assistant</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 mb-4">Facilitation Assistant</h1>
            <p class="lead mb-5">Create structured, time-boxed meetings with real-time attendee engagement</p>
            
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h3 class="mb-4">Create New Meeting</h3>
                    
                    <div class="mb-4">
                        <label for="meetingTitle" class="form-label">Meeting Title (optional)</label>
                        <input type="text" 
                               class="form-control form-control-lg" 
                               id="meetingTitle" 
                               @bind="meetingTitle" 
                               placeholder="Enter meeting title"
                               maxlength="200" />
                    </div>
                    
                    <button class="btn btn-primary btn-lg px-5" 
                            @onclick="CreateMeeting"
                            disabled="@isCreating">
                        @if (isCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span>Create Meeting</span>
                        }
                    </button>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                    }
                </div>
            </div>
            
            <div class="mt-5">
                <h5 class="text-muted">Features</h5>
                <div class="row mt-3">
                    <div class="col-md-4">
                        <div class="p-3">
                            <h6>⏱️ Time-Boxed Stages</h6>
                            <small class="text-muted">Keep meetings on track with visible timers</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3">
                            <h6>📋 Real-Time Agenda</h6>
                            <small class="text-muted">All participants see current progress</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3">
                            <h6>✋ Attendee Feedback</h6>
                            <small class="text-muted">Gather input without interrupting flow</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string meetingTitle = string.Empty;
    private bool isCreating = false;
    private string errorMessage = string.Empty;

    private async Task CreateMeeting()
    {
        isCreating = true;
        errorMessage = string.Empty;

        try
        {
            var command = new CreateMeetingCommand(meetingTitle);
            var result = await Mediator.Send(command);
            
            // Navigate to facilitator setup page
            Navigation.NavigateTo($"/facilitator/{result.FacilitatorToken}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create meeting: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }
}
