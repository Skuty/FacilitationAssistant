@page "/attendee/{token}"
@rendermode InteractiveServer
@using FacilitationAssistant.Core.Entities
@using FacilitationAssistant.Core.Queries
@using FacilitationAssistant.Core.Commands
@using MediatR
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>@(meeting?.Title ?? "Meeting") - Attendee</PageTitle>

@if (meeting == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading meeting...</p>
    </div>
}
else if (meeting.Status == MeetingStatus.Setup)
{
    <div class="container mt-5">
        <div class="text-center">
            <h2>⏳ Meeting Not Started Yet</h2>
            <p class="lead">The facilitator is setting up the meeting. Please wait...</p>
            <div class="spinner-border text-primary mt-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 bg-info text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">📋 @meeting.Title</h4>
                        <small>Attendee View</small>
                    </div>
                    <div>
                        @if (meeting.StartedAt != null)
                        {
                            <span class="badge bg-light text-dark fs-6">
                                ⏱️ @GetElapsedTime()
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5>📅 Meeting Agenda</h5>
                    </div>
                    <div class="card-body">
                        @if (!meeting.Stages.Any())
                        {
                            <p class="text-muted">No agenda stages defined.</p>
                        }
                        else
                        {
                            @foreach (var stage in meeting.Stages.OrderBy(s => s.OrderIndex))
                            {
                                <div class="card mb-3 @GetStageClass(stage)">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6>
                                                    @(stage.OrderIndex + 1). @stage.Name
                                                    @if (stage.Status == StageStatus.Active)
                                                    {
                                                        <span class="badge bg-primary ms-2">▶️ ACTIVE</span>
                                                    }
                                                    else if (stage.Status == StageStatus.Completed)
                                                    {
                                                        <span class="badge bg-success ms-2">✅ COMPLETED</span>
                                                    }
                                                </h6>
                                                
                                                @if (!string.IsNullOrEmpty(stage.Description))
                                                {
                                                    <p class="text-muted mb-2"><small>@stage.Description</small></p>
                                                }

                                                <div class="d-flex align-items-center gap-3">
                                                    <small class="text-muted">
                                                        <strong>Planned:</strong> @stage.PlannedDurationMinutes min
                                                    </small>
                                                    
                                                    @if (stage.Status == StageStatus.Active && stage.StartedAt != null)
                                                    {
                                                        <span class="text-primary fw-bold">
                                                            @GetStageTimeDisplay(stage)
                                                        </span>
                                                    }
                                                    
                                                    @if (stage.Status == StageStatus.Completed && stage.ActualDurationSeconds != null)
                                                    {
                                                        <span class="text-success">
                                                            <strong>Actual:</strong> @(stage.ActualDurationSeconds / 60) min
                                                        </span>
                                                    }
                                                </div>

                                                @if (stage.Status == StageStatus.Active)
                                                {
                                                    <div class="progress mt-2" style="height: 20px;">
                                                        <div class="progress-bar @GetProgressBarClass(stage)" 
                                                             style="width: @GetProgressPercentage(stage)%"
                                                             role="progressbar">
                                                            @GetProgressPercentage(stage)%
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">📝 Public Notes</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <textarea class="form-control" 
                                      placeholder="Add a public note..."
                                      @bind="newNoteContent"
                                      rows="3"
                                      maxlength="1000"></textarea>
                            <button class="btn btn-primary btn-sm mt-2" @onclick="AddNote">Add Note</button>
                        </div>

                        @if (meeting.Notes.Any(n => n.IsPublic))
                        {
                            @foreach (var note in meeting.Notes.Where(n => n.IsPublic).OrderByDescending(n => n.CreatedAt))
                            {
                                <div class="card mb-2 bg-light">
                                    <div class="card-body p-2">
                                        <small class="d-block">@note.Content</small>
                                        <small class="text-muted">@note.CreatedAt.ToString("HH:mm:ss")</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted"><small>No public notes yet.</small></p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header bg-warning">
                        <h6 class="mb-0">⚠️ Raise a Concern</h6>
                    </div>
                    <div class="card-body">
                        <select class="form-select mb-2" @bind="selectedConcernType">
                            <option value="">Select concern type...</option>
                            <option value="Too Fast">Too Fast</option>
                            <option value="Too Slow">Too Slow</option>
                            <option value="Unclear">Unclear</option>
                            <option value="Technical Issue">Technical Issue</option>
                            <option value="Other">Other</option>
                        </select>

                        @if (selectedConcernType == "Other")
                        {
                            <textarea class="form-control mb-2" 
                                      placeholder="Describe your concern..."
                                      @bind="customConcernText"
                                      rows="2"
                                      maxlength="500"></textarea>
                        }

                        <button class="btn btn-warning btn-sm" 
                                @onclick="RaiseConcern"
                                disabled="@string.IsNullOrEmpty(selectedConcernType)">
                            Raise Concern
                        </button>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">📊 Meeting Progress</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Stages:</strong> @meeting.Stages.Count(s => s.Status == StageStatus.Completed) / @meeting.Stages.Count completed
                        </div>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-success" 
                                 style="width: @GetOverallProgress()%">
                                @GetOverallProgress()%
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private Meeting? meeting;
    private System.Threading.Timer? refreshTimer;
    private string sessionId = Guid.NewGuid().ToString();

    // UI fields
    private string newNoteContent = string.Empty;
    private string selectedConcernType = string.Empty;
    private string customConcernText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadMeeting();
        
        // If meeting is ended, redirect to summary
        if (meeting?.Status == MeetingStatus.Ended)
        {
            Navigation.NavigateTo($"/summary/{Token}");
            return;
        }
        
        // Refresh every 2 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await LoadMeeting();
            
            // Check if meeting ended during the session
            if (meeting?.Status == MeetingStatus.Ended)
            {
                await InvokeAsync(() => Navigation.NavigateTo($"/summary/{Token}"));
                return;
            }
            
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task LoadMeeting()
    {
        var query = new GetMeetingByTokenQuery(Token, false);
        meeting = await Mediator.Send(query);
    }

    private async Task AddNote()
    {
        if (meeting == null || string.IsNullOrWhiteSpace(newNoteContent)) return;

        var activeStage = meeting.Stages.FirstOrDefault(s => s.Status == StageStatus.Active);
        
        var command = new AddNoteCommand(
            meeting.Id,
            sessionId,
            newNoteContent,
            true, // Public note
            activeStage?.Id
        );

        await Mediator.Send(command);
        newNoteContent = string.Empty;
        await LoadMeeting();
    }

    private async Task RaiseConcern()
    {
        if (meeting == null || string.IsNullOrEmpty(selectedConcernType)) return;

        var command = new RaiseConcernCommand(
            meeting.Id,
            sessionId,
            selectedConcernType,
            selectedConcernType == "Other" ? customConcernText : null
        );

        await Mediator.Send(command);
        selectedConcernType = string.Empty;
        customConcernText = string.Empty;
        await LoadMeeting();
    }

    private string GetElapsedTime()
    {
        if (meeting?.StartedAt == null) return "0:00";
        var elapsed = DateTime.UtcNow - meeting.StartedAt.Value;
        return $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:D2}";
    }

    private string GetStageTimeDisplay(AgendaStage stage)
    {
        if (stage.StartedAt == null) return "";
        
        var elapsed = DateTime.UtcNow - stage.StartedAt.Value;
        var plannedMinutes = stage.PlannedDurationMinutes;
        
        if (elapsed.TotalMinutes >= plannedMinutes)
        {
            var overrun = elapsed - TimeSpan.FromMinutes(plannedMinutes);
            return $"⚠️ Overrun by {(int)overrun.TotalMinutes}:{overrun.Seconds:D2}";
        }
        
        var remaining = TimeSpan.FromMinutes(plannedMinutes) - elapsed;
        return $"⏱️ {(int)remaining.TotalMinutes}:{remaining.Seconds:D2} remaining";
    }

    private int GetProgressPercentage(AgendaStage stage)
    {
        if (stage.StartedAt == null) return 0;
        var elapsed = (DateTime.UtcNow - stage.StartedAt.Value).TotalMinutes;
        var percentage = (int)((elapsed / stage.PlannedDurationMinutes) * 100);
        return Math.Min(percentage, 150);
    }

    private string GetProgressBarClass(AgendaStage stage)
    {
        var percentage = GetProgressPercentage(stage);
        return percentage > 100 ? "bg-danger" : "bg-success";
    }

    private string GetStageClass(AgendaStage stage)
    {
        return stage.Status switch
        {
            StageStatus.Active => "border-primary border-3",
            StageStatus.Completed => "border-success",
            _ => ""
        };
    }

    private int GetOverallProgress()
    {
        if (meeting == null || !meeting.Stages.Any()) return 0;
        var completed = meeting.Stages.Count(s => s.Status == StageStatus.Completed);
        return (int)((double)completed / meeting.Stages.Count * 100);
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
