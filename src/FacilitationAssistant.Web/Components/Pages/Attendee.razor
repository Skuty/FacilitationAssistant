@page "/attendee/{token}"
@rendermode InteractiveServer
@using FacilitationAssistant.Core.Entities
@using FacilitationAssistant.Core.Queries
@using FacilitationAssistant.Core.Commands
@using Mediator
@using Microsoft.AspNetCore.SignalR.Client
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>@(meeting?.Title ?? "Meeting") - Attendee</PageTitle>

<a href="#main-content" class="skip-link">Skip to main content</a>

@if (meeting == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading meeting...</p>
    </div>
}
else if (meeting.Status == MeetingStatus.Setup)
{
    <div class="container mt-5">
        <div class="text-center">
            <h2>⏳ Meeting Not Started Yet</h2>
            <p class="lead">The facilitator is setting up the meeting. Please wait...</p>
            <div class="spinner-border text-primary mt-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 bg-info text-white p-3" role="banner">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0"><span aria-hidden="true">📋</span> @meeting.Title</h4>
                        <small>Attendee View | <span aria-hidden="true">🎭</span> Attendee #@GetAttendeeNumber()</small>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-outline-light me-2" @onclick="() => showSettings = true" aria-label="Open settings"><span aria-hidden="true">⚙️</span></button>
                        <button class="btn btn-sm btn-outline-light me-2" @onclick="ShowWelcomeManually" aria-label="Show welcome tour"><span aria-hidden="true">❓</span></button>
                        @if (meeting.StartedAt != null)
                        {
                            <span class="badge bg-light text-dark fs-6" aria-live="off" aria-label="Meeting elapsed time">
                                <span aria-hidden="true">⏱️</span> @GetElapsedTime()
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-8">
                <div class="card" id="main-content" role="main">
                    <div class="card-header">
                        <h5><span aria-hidden="true">📅</span> Meeting Agenda</h5>
                    </div>
                    <div class="card-body">
                        @if (!meeting.Stages.Any())
                        {
                            <p class="text-muted">No agenda stages defined.</p>
                        }
                        else
                        {
                            @foreach (var stage in meeting.Stages.OrderBy(s => s.OrderIndex))
                            {
                                <div class="card mb-3 @GetStageClass(stage)">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6>
                                                    @(stage.OrderIndex + 1). @stage.Name
                                                    @if (stage.Status == StageStatus.Active)
                                                    {
                                                        <span class="badge bg-primary ms-2">▶️ ACTIVE</span>
                                                    }
                                                    else if (stage.Status == StageStatus.Completed)
                                                    {
                                                        <span class="badge bg-success ms-2">✅ COMPLETED</span>
                                                    }
                                                </h6>
                                                
                                                @if (!string.IsNullOrEmpty(stage.Description))
                                                {
                                                    <p class="text-muted mb-2"><small>@stage.Description</small></p>
                                                }

                                                <div class="d-flex align-items-center gap-3">
                                                    <small class="text-muted">
                                                        <strong>Planned:</strong> @stage.PlannedDurationMinutes min
                                                    </small>
                                                    
                                                    @if (stage.Status == StageStatus.Active && stage.StartedAt != null)
                                                    {
                                                        <span class="text-primary fw-bold" aria-live="polite" aria-atomic="true">
                                                            @GetStageTimeDisplay(stage)
                                                        </span>
                                                    }
                                                    
                                                    @if (stage.Status == StageStatus.Completed && stage.ActualDurationSeconds != null)
                                                    {
                                                        <span class="text-success">
                                                            <strong>Actual:</strong> @(stage.ActualDurationSeconds / 60) min
                                                        </span>
                                                    }
                                                </div>

                                                @if (stage.Status == StageStatus.Active)
                                                {
                                                    <div class="progress mt-2" style="height: 20px;">
                                                        <div class="progress-bar @GetProgressBarClass(stage)" 
                                                             style="width: @GetProgressPercentage(stage)%"
                                                             role="progressbar"
                                                             aria-valuenow="@GetProgressPercentage(stage)"
                                                             aria-valuemin="0"
                                                             aria-valuemax="100"
                                                             aria-label="Stage progress: @GetProgressPercentage(stage) percent complete">
                                                            @GetProgressPercentage(stage)%
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">📝 Notes</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <textarea class="form-control" 
                                      placeholder="Add a note..."
                                      @bind="newNoteContent"
                                      rows="3"
                                      maxlength="1000"></textarea>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="noteVisibilityCheck" @bind="newNoteIsPublic">
                                    <label class="form-check-label" for="noteVisibilityCheck">
                                        <small>👁️ Make note public (visible to all)</small>
                                    </label>
                                </div>
                                <button class="btn btn-primary btn-sm" @onclick="AddNote">Add Note</button>
                            </div>
                        </div>

                        @{
                            var visibleNotes = meeting.Notes
                                .Where(n => n.IsPublic || n.SessionId == sessionId)
                                .OrderByDescending(n => n.CreatedAt)
                                .ToList();
                        }

                        @if (visibleNotes.Any())
                        {
                            @foreach (var note in visibleNotes)
                            {
                                var isOwnNote = note.SessionId == sessionId;
                                var isEditing = editingNoteId == note.Id;
                                
                                <div class="card mb-2 @(note.IsPublic ? "bg-light" : "bg-warning bg-opacity-10")">
                                    <div class="card-body p-2">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <div class="flex-grow-1">
                                                @if (isEditing)
                                                {
                                                    <textarea class="form-control form-control-sm mb-2" 
                                                              @bind="editNoteContent"
                                                              rows="3"
                                                              maxlength="1000"></textarea>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-success btn-sm" @onclick="SaveNoteEdit">💾 Save</button>
                                                        <button class="btn btn-secondary btn-sm" @onclick="CancelNoteEdit">Cancel</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-start gap-2">
                                                        <span>@(note.IsPublic ? "👁️" : "🔒")</span>
                                                        <div class="flex-grow-1">
                                                            <small class="d-block">@note.Content</small>
                                                            <small class="text-muted">
                                                                @note.CreatedAt.ToString("HH:mm:ss")
                                                                @if (note.UpdatedAt.HasValue)
                                                                {
                                                                    <span> (edited)</span>
                                                                }
                                                                @if (isOwnNote)
                                                                {
                                                                    <span class="badge bg-info ms-1">Your Note</span>
                                                                }
                                                            </small>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            @if (isOwnNote && !isEditing)
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleNoteVisibility(note.Id, note.IsPublic)" title="Toggle visibility">
                                                        @(note.IsPublic ? "🔒" : "👁️")
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditNote(note.Id, note.Content)" title="Edit">✏️</button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteNote(note.Id)" title="Delete">🗑️</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted"><small>No notes yet.</small></p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header bg-warning">
                        <h6 class="mb-0">⚠️ Concerns</h6>
                    </div>
                    <div class="card-body">
                        <button class="btn btn-warning btn-sm w-100" 
                                @onclick="OpenConcernModal"
                                aria-label="Raise a concern">
                            ⚠️ Raise a Concern
                        </button>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">📊 Meeting Progress</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Stages:</strong> @meeting.Stages.Count(s => s.Status == StageStatus.Completed) / @meeting.Stages.Count completed
                        </div>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-success" 
                                 style="width: @GetOverallProgress()%">
                                @GetOverallProgress()%
                            </div>
                        </div>
                        
                        @if (pendingQuestions.Any())
                        {
                            <div class="mt-3">
                                <span class="badge bg-info">
                                    ❓ @pendingQuestions.Count pending question@(pendingQuestions.Count > 1 ? "s" : "")
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">💬 Concerns (@concerns.Count(c => !c.IsWithdrawn))</h6>
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (!concerns.Any())
                        {
                            <p class="text-muted"><small>No concerns raised yet.</small></p>
                        }
                        else
                        {
                            @foreach (var concern in concerns.OrderByDescending(c => c.CreatedAt))
                            {
                                var likeCount = concern.Votes.Count(v => v.VoteType == VoteType.Like);
                                var dislikeCount = concern.Votes.Count(v => v.VoteType == VoteType.Dislike);
                                var neutralCount = concern.Votes.Count(v => v.VoteType == VoteType.Neutral);
                                var userVote = concern.Votes.FirstOrDefault(v => v.SessionId == sessionId);
                                var isOwnConcern = concern.SessionId == sessionId;
                                
                                <div class="card mb-2 @(concern.IsWithdrawn ? "opacity-50" : "")">
                                    <div class="card-body p-2">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="flex-grow-1">
                                                <strong>@concern.ConcernType</strong>
                                                @if (isOwnConcern)
                                                {
                                                    <span class="badge bg-info ms-2">Your Concern</span>
                                                }
                                                @if (concern.IsAcknowledged)
                                                {
                                                    <span class="badge bg-success ms-2">✓ Acknowledged</span>
                                                }
                                                @if (concern.IsWithdrawn)
                                                {
                                                    <span class="badge bg-secondary ms-2">Withdrawn</span>
                                                }
                                                @if (!string.IsNullOrEmpty(concern.CustomText))
                                                {
                                                    <p class="mb-0 mt-1"><small>@concern.CustomText</small></p>
                                                }
                                                <small class="text-muted d-block">@GetTimeAgo(concern.CreatedAt)</small>
                                            </div>
                                            @if (isOwnConcern && !concern.IsWithdrawn)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => WithdrawConcern(concern.Id)">
                                                    Withdraw
                                                </button>
                                            }
                                        </div>
                                        
                                        @if (!concern.IsWithdrawn)
                                        {
                                            <div class="btn-group btn-group-sm mb-2" role="group">
                                                <button type="button" 
                                                        class="btn @(userVote?.VoteType == VoteType.Like ? "btn-primary" : "btn-outline-primary")" 
                                                        @onclick="() => VoteConcern(concern.Id, VoteType.Like)">
                                                    👍 @likeCount
                                                </button>
                                                <button type="button" 
                                                        class="btn @(userVote?.VoteType == VoteType.Dislike ? "btn-danger" : "btn-outline-danger")" 
                                                        @onclick="() => VoteConcern(concern.Id, VoteType.Dislike)">
                                                    👎 @dislikeCount
                                                </button>
                                                <button type="button" 
                                                        class="btn @(userVote?.VoteType == VoteType.Neutral ? "btn-secondary" : "btn-outline-secondary")" 
                                                        @onclick="() => VoteConcern(concern.Id, VoteType.Neutral)">
                                                    😐 @neutralCount
                                                </button>
                                            </div>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(concern.ResponseText))
                                        {
                                            <div class="alert alert-info mb-0 mt-2 p-2">
                                                <small><strong>Facilitator:</strong> @concern.ResponseText</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Delete Note Confirmation Dialog *@
    @if (deletingNoteId.HasValue)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">🗑️ Delete Note</h5>
                        <button type="button" class="btn-close" @onclick="() => deletingNoteId = null"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this note? This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => deletingNoteId = null">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="() => DeleteNote(deletingNoteId.Value)">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Question Modal *@
    @if (currentQuestion != null && !showConfirmation)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">❓ Question</h5>
                        @if (pendingQuestions.Count > 1)
                        {
                            <span class="badge bg-secondary">+@(pendingQuestions.Count - 1) more</span>
                        }
                    </div>
                    <div class="modal-body">
                        <p class="fw-bold">@currentQuestion.Text</p>

                        @if (currentQuestion.AnswerType == QuestionAnswerType.SingleChoice)
                        {
                            <div class="list-group">
                                @foreach (var option in currentQuestion.Options.OrderBy(o => o.OrderIndex))
                                {
                                    <label class="list-group-item list-group-item-action">
                                        <input type="radio" 
                                               name="singleChoice" 
                                               value="@option.Id" 
                                               @onchange="@(() => selectedSingleChoice = option.Id)"
                                               checked="@(selectedSingleChoice == option.Id)">
                                        <span class="ms-2">@option.OptionText</span>
                                    </label>
                                }
                            </div>
                        }
                        else if (currentQuestion.AnswerType == QuestionAnswerType.MultipleChoice)
                        {
                            <div class="list-group">
                                @foreach (var option in currentQuestion.Options.OrderBy(o => o.OrderIndex))
                                {
                                    <label class="list-group-item">
                                        <input type="checkbox" 
                                               value="@option.Id" 
                                               @onchange="@((e) => ToggleMultipleChoice(option.Id, (bool)e.Value!))"
                                               checked="@(selectedMultipleChoices.Contains(option.Id))">
                                        <span class="ms-2">@option.OptionText</span>
                                    </label>
                                }
                            </div>
                            @if (currentQuestion.MaxSelectableOptions != null)
                            {
                                <small class="text-muted">Select up to @currentQuestion.MaxSelectableOptions options</small>
                            }
                        }
                        else if (currentQuestion.AnswerType == QuestionAnswerType.FreeText)
                        {
                            <textarea class="form-control" 
                                      @bind="freeTextAnswer" 
                                      rows="4" 
                                      maxlength="1000" 
                                      placeholder="Type your answer..."></textarea>
                            <small class="text-muted">@freeTextAnswer.Length / 1000 characters</small>
                        }
                        else if (currentQuestion.AnswerType == QuestionAnswerType.Scale)
                        {
                            <div class="text-center">
                                <div class="d-flex justify-content-between mb-2">
                                    <small class="text-muted">@currentQuestion.ScaleMinLabel</small>
                                    <small class="text-muted">@currentQuestion.ScaleMaxLabel</small>
                                </div>
                                <div class="btn-group w-100" role="group">
                                    @for (int i = currentQuestion.ScaleMin ?? 1; i <= (currentQuestion.ScaleMax ?? 5); i++)
                                    {
                                        var value = i; // Capture for lambda
                                        <button type="button" 
                                                class="btn @(scaleValue == value ? "btn-primary" : "btn-outline-primary")"
                                                @onclick="@(() => scaleValue = value)">
                                            @value
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" 
                                class="btn btn-link text-muted" 
                                @onclick="SkipQuestion">
                            Skip
                        </button>
                        <button type="button" 
                                class="btn btn-primary" 
                                @onclick="SubmitAnswer"
                                disabled="@(!IsAnswerValid())">
                            @(isSubmitting ? "Submitting..." : "Submit")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Confirmation Message *@
    @if (showConfirmation)
    {
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
            <div class="toast show" role="alert">
                <div class="toast-header bg-success text-white">
                    <strong class="me-auto">✅ Success</strong>
                </div>
                <div class="toast-body">
                    Answer submitted successfully!
                </div>
            </div>
        </div>
    }

    @* Results Display *@
    @if (showResults && justAnsweredQuestion != null && questionResults.ContainsKey(justAnsweredQuestion.Id))
    {
        var results = questionResults[justAnsweredQuestion.Id];
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">📊 Question Results</h5>
                        <button type="button" class="btn-close" @onclick="() => showResults = false"></button>
                    </div>
                    <div class="modal-body">
                        <p class="fw-bold">@justAnsweredQuestion.Text</p>
                        
                        <div class="mb-3">
                            <small class="text-muted">
                                <strong>Responses:</strong> @results.TotalResponses | 
                                <strong>Pending:</strong> @results.TotalPending
                            </small>
                        </div>

                        @if (justAnsweredQuestion.AnswerType == QuestionAnswerType.SingleChoice || 
                             justAnsweredQuestion.AnswerType == QuestionAnswerType.MultipleChoice)
                        {
                            @if (results.ChoiceResults != null && justAnsweredQuestion.ResultVisibility == QuestionResultVisibility.AggregatedResultsToAttendees)
                            {
                                <div class="mt-2">
                                    <h6>Results:</h6>
                                    @foreach (var option in justAnsweredQuestion.Options.OrderBy(o => o.OrderIndex))
                                    {
                                        var count = results.ChoiceResults.ContainsKey(option.Id) ? results.ChoiceResults[option.Id] : 0;
                                        var percentage = results.TotalResponses > 0 ? (int)((count / (double)results.TotalResponses) * 100) : 0;
                                        <div class="mb-2">
                                            <small>@option.OptionText: @count (@percentage%)</small>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar" style="width: @percentage%"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (justAnsweredQuestion.ResultVisibility == QuestionResultVisibility.AllResponsesToAttendees)
                            {
                                <div class="alert alert-info">
                                    <small>All individual responses visible to facilitator</small>
                                </div>
                            }
                        }
                        else if (justAnsweredQuestion.AnswerType == QuestionAnswerType.Scale && results.ScaleResults != null)
                        {
                            @if (justAnsweredQuestion.ResultVisibility == QuestionResultVisibility.AggregatedResultsToAttendees)
                            {
                                <div class="mt-2">
                                    <h6>Results:</h6>
                                    <div class="mb-3">
                                        <strong>Average Score:</strong> @results.ScaleResults.AverageScore.ToString("F1") out of @justAnsweredQuestion.ScaleMax
                                    </div>
                                    <div class="mt-2">
                                        <small><strong>Distribution:</strong></small>
                                        @foreach (var kvp in results.ScaleResults.Distribution.OrderBy(d => d.Key))
                                        {
                                            var percentage = results.TotalResponses > 0 ? (int)((kvp.Value / (double)results.TotalResponses) * 100) : 0;
                                            <div class="mb-1">
                                                <small>@kvp.Key: @kvp.Value (@percentage%)</small>
                                                <div class="progress" style="height: 15px;">
                                                    <div class="progress-bar bg-info" style="width: @percentage%"></div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (justAnsweredQuestion.AnswerType == QuestionAnswerType.FreeText)
                        {
                            @if (justAnsweredQuestion.ResultVisibility == QuestionResultVisibility.AggregatedResultsToAttendees)
                            {
                                <div class="mt-2">
                                    <small><strong>Total Responses:</strong> @results.TotalResponses</small>
                                </div>
                            }
                            else if (justAnsweredQuestion.ResultVisibility == QuestionResultVisibility.AllResponsesToAttendees && results.FreeTextAnswers != null)
                            {
                                <div class="mt-2">
                                    <h6>All Responses:</h6>
                                    <ul class="list-group">
                                        @foreach (var answer in results.FreeTextAnswers)
                                        {
                                            <li class="list-group-item"><small>@answer</small></li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => showResults = false">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Concern Modal *@
    @if (showConcernModal)
    {
        <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="concernModalTitle" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="concernModalTitle">⚠️ Raise a Concern</h5>
                        <button type="button" class="btn-close" @onclick="CloseConcernModal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-3">
                            <small>Select a predefined concern or describe a custom issue.</small>
                        </p>
                        
                        <div class="mb-3">
                            <label class="form-label">Concern Type</label>
                            <div class="d-grid gap-2">
                                <button type="button" 
                                        class="btn @(selectedConcernType == "Meeting Overrunning" ? "btn-warning" : "btn-outline-warning") text-start"
                                        @onclick='() => { selectedConcernType = "Meeting Overrunning"; customConcernText = string.Empty; concernValidationError = null; }'>
                                    ⏱️ Meeting Overrunning
                                </button>
                                <button type="button" 
                                        class="btn @(selectedConcernType == "Topic Unclear" ? "btn-warning" : "btn-outline-warning") text-start"
                                        @onclick='() => { selectedConcernType = "Topic Unclear"; customConcernText = string.Empty; concernValidationError = null; }'>
                                    ❓ Topic Unclear
                                </button>
                                <button type="button" 
                                        class="btn @(selectedConcernType == "Technical Issue" ? "btn-warning" : "btn-outline-warning") text-start"
                                        @onclick='() => { selectedConcernType = "Technical Issue"; customConcernText = string.Empty; concernValidationError = null; }'>
                                    🔧 Technical Issue
                                </button>
                                <button type="button" 
                                        class="btn @(selectedConcernType == "Need Break" ? "btn-warning" : "btn-outline-warning") text-start"
                                        @onclick='() => { selectedConcernType = "Need Break"; customConcernText = string.Empty; concernValidationError = null; }'>
                                    ☕ Need Break
                                </button>
                                <button type="button" 
                                        class="btn @(selectedConcernType == "Custom Reason" ? "btn-warning" : "btn-outline-warning") text-start"
                                        @onclick='() => { selectedConcernType = "Custom Reason"; concernValidationError = null; }'>
                                    ✏️ Custom Reason
                                </button>
                            </div>
                        </div>

                        @if (selectedConcernType == "Custom Reason")
                        {
                            <div class="mb-3">
                                <label class="form-label">Describe your concern (10-200 characters)</label>
                                <textarea class="form-control @(concernValidationError != null ? "is-invalid" : "")" 
                                          placeholder="Describe your concern..."
                                          @bind="customConcernText"
                                          rows="3"
                                          maxlength="200"></textarea>
                                <div class="form-text">
                                    @customConcernText.Length / 200 characters
                                </div>
                                @if (concernValidationError != null)
                                {
                                    <div class="invalid-feedback d-block">@concernValidationError</div>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseConcernModal">Cancel</button>
                        <button type="button" 
                                class="btn btn-warning" 
                                @onclick="RaiseConcern"
                                disabled="@string.IsNullOrEmpty(selectedConcernType)">
                            Submit Concern
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Concern Confirmation Toast *@
    @if (showConcernConfirmation)
    {
        <div class="position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 9999;">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>✓ Concern raised</strong> - Your concern has been submitted to the facilitator.
                <button type="button" class="btn-close" @onclick="() => showConcernConfirmation = false"></button>
            </div>
        </div>
    }

    @* Attendee Messages *@
    @if (meeting != null)
    {
        <AttendeeMessages MeetingId="@meeting.Id" SessionId="@sessionId" @ref="attendeeMessages" />
    }

    @* Welcome Modal *@
    <AttendeeWelcome @ref="attendeeWelcome" AttendeeNumber="@GetAttendeeNumber()" />

    @* Settings Modal *@
    <SettingsModal IsOpen="showSettings" IsOpenChanged="async (isOpen) => { showSettings = isOpen; StateHasChanged(); }" />
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private Meeting? meeting;
    private HubConnection? _hubConnection;
    private CancellationTokenSource? _tickCts;
    private string sessionId = Guid.NewGuid().ToString();
    private bool showSettings = false;
    
    // Concerns
    private List<Concern> concerns = new();

    // UI fields
    private string newNoteContent = string.Empty;
    private bool newNoteIsPublic = true;
    private Guid? editingNoteId = null;
    private string editNoteContent = string.Empty;
    private Guid? deletingNoteId = null;
    private string selectedConcernType = string.Empty;
    private string customConcernText = string.Empty;
    private bool showConcernModal = false;
    private string? concernValidationError = null;
    private bool showConcernConfirmation = false;

    // Question UI fields
    private List<Question> pendingQuestions = new();
    private Question? currentQuestion = null;
    private HashSet<Guid> answeredQuestionIds = new();
    private Dictionary<Guid, QuestionResultsDto> questionResults = new();
    private Question? justAnsweredQuestion = null;
    
    // Answer fields
    private Guid? selectedSingleChoice = null;
    private HashSet<Guid> selectedMultipleChoices = new();
    private string freeTextAnswer = string.Empty;
    private int? scaleValue = null;
    
    // UI state
    private bool isSubmitting = false;
    private bool showConfirmation = false;
    private bool showResults = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadMeeting();
        
        // If meeting is ended, redirect to summary
        if (meeting?.Status == MeetingStatus.Ended)
        {
            Navigation.NavigateTo($"/summary/{Token}");
            return;
        }
        
        // Setup SignalR connection
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/meetinghub"))
            .WithAutomaticReconnect()
            .Build();
        
        // Handle meeting updates
        _hubConnection.On<string>("MeetingUpdated", async (updateType) =>
        {
            await LoadMeeting();
            await LoadActiveQuestions();
            await LoadConcerns();
            
            // Refresh messages
            if (attendeeMessages != null)
            {
                await attendeeMessages.Refresh();
            }
            
            // Check if meeting ended
            if (meeting?.Status == MeetingStatus.Ended)
            {
                StopTickTimer();
                await InvokeAsync(() => Navigation.NavigateTo($"/summary/{Token}"));
                return;
            }

            // Start or stop the local tick timer based on whether a stage is active
            if (meeting?.Stages.Any(s => s.Status == StageStatus.Active) == true)
                StartTickTimer();
            else
                StopTickTimer();
            
            await InvokeAsync(StateHasChanged);
        });
        
        await _hubConnection.StartAsync();
        
        // Join meeting group
        if (meeting != null)
        {
            await _hubConnection.InvokeAsync("JoinMeeting", meeting.Id.ToString());
        }

        // Start per-second tick if a stage is already active
        if (meeting?.Stages.Any(s => s.Status == StageStatus.Active) == true)
            StartTickTimer();
    }

    private async Task LoadMeeting()
    {
        var query = new GetMeetingByTokenQuery(Token, false);
        meeting = await Mediator.Send(query);
    }

    private async Task LoadActiveQuestions()
    {
        if (meeting == null) return;
        
        var query = new GetActiveQuestionsForAttendeeQuery(meeting.Id, sessionId);
        var activeQuestions = await Mediator.Send(query);
        
        // Filter out already answered questions
        pendingQuestions = activeQuestions
            .Where(q => !answeredQuestionIds.Contains(q.Id))
            .ToList();
        
        // Show first question if we don't have a current one
        if (currentQuestion == null && pendingQuestions.Any())
        {
            currentQuestion = pendingQuestions.First();
            ResetAnswerFields();
        }
    }

    private async Task LoadQuestionResults(Guid questionId)
    {
        var resultsQuery = new GetQuestionResultsQuery(questionId);
        var results = await Mediator.Send(resultsQuery);
        if (results != null)
        {
            questionResults[questionId] = results;
        }
    }

    private void ResetAnswerFields()
    {
        selectedSingleChoice = null;
        selectedMultipleChoices.Clear();
        freeTextAnswer = string.Empty;
        scaleValue = null;
    }

    private void ToggleMultipleChoice(Guid optionId, bool isChecked)
    {
        if (isChecked)
        {
            // Check if we've reached the max selectable options
            if (currentQuestion?.MaxSelectableOptions != null && 
                selectedMultipleChoices.Count >= currentQuestion.MaxSelectableOptions)
            {
                return; // Don't add more
            }
            selectedMultipleChoices.Add(optionId);
        }
        else
        {
            selectedMultipleChoices.Remove(optionId);
        }
    }

    private bool IsAnswerValid()
    {
        if (currentQuestion == null) return false;

        return currentQuestion.AnswerType switch
        {
            QuestionAnswerType.SingleChoice => selectedSingleChoice.HasValue,
            QuestionAnswerType.MultipleChoice => selectedMultipleChoices.Any(),
            QuestionAnswerType.FreeText => !string.IsNullOrWhiteSpace(freeTextAnswer),
            QuestionAnswerType.Scale => scaleValue.HasValue,
            _ => false
        };
    }

    private async Task SubmitAnswer()
    {
        if (currentQuestion == null || isSubmitting || !IsAnswerValid()) return;

        isSubmitting = true;

        try
        {
            List<string>? answerChoiceIds = null;
            string? answerText = null;
            int? answerScaleValue = null;

            switch (currentQuestion.AnswerType)
            {
                case QuestionAnswerType.SingleChoice:
                    answerChoiceIds = selectedSingleChoice.HasValue 
                        ? new List<string> { selectedSingleChoice.Value.ToString() } 
                        : null;
                    break;
                case QuestionAnswerType.MultipleChoice:
                    answerChoiceIds = selectedMultipleChoices.Select(id => id.ToString()).ToList();
                    break;
                case QuestionAnswerType.FreeText:
                    answerText = freeTextAnswer;
                    break;
                case QuestionAnswerType.Scale:
                    answerScaleValue = scaleValue;
                    break;
            }

            var command = new SubmitQuestionResponseCommand(
                currentQuestion.Id,
                sessionId,
                answerChoiceIds,
                answerText,
                answerScaleValue,
                QuestionResponseStatus.Submitted
            );

            await Mediator.Send(command);
            
            // Mark as answered
            answeredQuestionIds.Add(currentQuestion.Id);
            
            // Check if we should show results
            if (currentQuestion.ResultVisibility != QuestionResultVisibility.FacilitatorOnly)
            {
                // Load results for this question
                justAnsweredQuestion = currentQuestion;
                await LoadQuestionResults(currentQuestion.Id);
                showResults = true;
                
                // Hide results after 5 seconds
                _ = Task.Delay(5000).ContinueWith(_ => 
                {
                    showResults = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                // Show simple confirmation
                showConfirmation = true;
                
                // Hide confirmation after 2 seconds
                _ = Task.Delay(2000).ContinueWith(_ => 
                {
                    showConfirmation = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            
            // Move to next question
            MoveToNextQuestion();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SkipQuestion()
    {
        if (currentQuestion == null) return;

        var command = new SubmitQuestionResponseCommand(
            currentQuestion.Id,
            sessionId,
            null,
            null,
            null,
            QuestionResponseStatus.Skipped
        );

        await Mediator.Send(command);
        
        // Mark as answered (even though skipped)
        answeredQuestionIds.Add(currentQuestion.Id);
        
        MoveToNextQuestion();
    }

    private void MoveToNextQuestion()
    {
        // Remove current question from pending list
        if (currentQuestion != null)
        {
            pendingQuestions.Remove(currentQuestion);
        }
        
        // Show next question if available
        currentQuestion = pendingQuestions.FirstOrDefault();
        ResetAnswerFields();
    }

    private async Task AddNote()
    {
        if (meeting == null || string.IsNullOrWhiteSpace(newNoteContent)) return;

        var activeStage = meeting.Stages.FirstOrDefault(s => s.Status == StageStatus.Active);
        
        var command = new AddNoteCommand(
            meeting.Id,
            sessionId,
            newNoteContent,
            newNoteIsPublic,
            activeStage?.Id
        );

        await Mediator.Send(command);
        newNoteContent = string.Empty;
        newNoteIsPublic = true;
        await LoadMeeting();
    }

    private void StartEditNote(Guid noteId, string content)
    {
        editingNoteId = noteId;
        editNoteContent = content;
    }

    private void CancelNoteEdit()
    {
        editingNoteId = null;
        editNoteContent = string.Empty;
    }

    private async Task SaveNoteEdit()
    {
        if (editingNoteId == null || string.IsNullOrWhiteSpace(editNoteContent)) return;

        var command = new UpdateNoteCommand(
            editingNoteId.Value,
            sessionId,
            Content: editNoteContent
        );

        await Mediator.Send(command);
        editingNoteId = null;
        editNoteContent = string.Empty;
        await LoadMeeting();
    }

    private async Task ToggleNoteVisibility(Guid noteId, bool currentIsPublic)
    {
        var command = new UpdateNoteCommand(
            noteId,
            sessionId,
            IsPublic: !currentIsPublic
        );

        await Mediator.Send(command);
        await LoadMeeting();
    }

    private void ConfirmDeleteNote(Guid noteId)
    {
        deletingNoteId = noteId;
    }

    private async Task DeleteNote(Guid noteId)
    {
        var command = new DeleteNoteCommand(noteId, sessionId);
        await Mediator.Send(command);
        deletingNoteId = null;
        await LoadMeeting();
    }

    private void OpenConcernModal()
    {
        selectedConcernType = string.Empty;
        customConcernText = string.Empty;
        concernValidationError = null;
        showConcernModal = true;
    }

    private void CloseConcernModal()
    {
        showConcernModal = false;
        selectedConcernType = string.Empty;
        customConcernText = string.Empty;
        concernValidationError = null;
    }

    private async Task RaiseConcern()
    {
        if (meeting == null || string.IsNullOrEmpty(selectedConcernType)) return;

        // Validate custom text if "Custom Reason" is selected
        if (selectedConcernType == "Custom Reason")
        {
            if (string.IsNullOrWhiteSpace(customConcernText))
            {
                concernValidationError = "Please provide a description for your custom concern.";
                return;
            }
            if (customConcernText.Length < 10)
            {
                concernValidationError = "Custom concern must be at least 10 characters.";
                return;
            }
            if (customConcernText.Length > 200)
            {
                concernValidationError = "Custom concern must be no more than 200 characters.";
                return;
            }
        }

        concernValidationError = null;

        var command = new RaiseConcernCommand(
            meeting.Id,
            sessionId,
            selectedConcernType,
            selectedConcernType == "Custom Reason" ? customConcernText : null
        );

        await Mediator.Send(command);
        
        // Close modal and show confirmation
        showConcernModal = false;
        showConcernConfirmation = true;
        selectedConcernType = string.Empty;
        customConcernText = string.Empty;
        
        await LoadMeeting();
        await LoadConcerns();
        
        // Hide confirmation after 3 seconds
        await Task.Delay(3000);
        showConcernConfirmation = false;
        StateHasChanged();
    }

    private async Task LoadConcerns()
    {
        if (meeting == null) return;
        
        var query = new GetConcernsByMeetingQuery(meeting.Id);
        var result = await Mediator.Send(query);
        concerns = result.ToList();
    }

    private async Task VoteConcern(Guid concernId, VoteType voteType)
    {
        var command = new VoteConcernCommand(concernId, sessionId, voteType);
        await Mediator.Send(command);
        await LoadConcerns();
    }

    private async Task WithdrawConcern(Guid concernId)
    {
        var command = new WithdrawConcernCommand(concernId, sessionId);
        await Mediator.Send(command);
        await LoadConcerns();
    }

    private void StartTickTimer()
    {
        if (_tickCts != null) return; // already running
        _tickCts = new CancellationTokenSource();
        var cts = _tickCts;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                while (await timer.WaitForNextTickAsync(cts.Token))
                    await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { }
        });
    }

    private void StopTickTimer()
    {
        _tickCts?.Cancel();
        _tickCts?.Dispose();
        _tickCts = null;
    }

    private string GetTimeAgo(DateTime createdAt)
    {
        var elapsed = DateTime.UtcNow - createdAt;
        if (elapsed.TotalMinutes < 1) return "Just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes} min ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours} hr ago";
        return createdAt.ToString("MMM dd");
    }

    private string GetElapsedTime()
    {
        if (meeting?.StartedAt == null) return "0:00";
        var elapsed = DateTime.UtcNow - meeting.StartedAt.Value;
        return $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:D2}";
    }

    private string GetStageTimeDisplay(AgendaStage stage)
    {
        if (stage.StartedAt == null) return "";
        
        var elapsed = DateTime.UtcNow - stage.StartedAt.Value;
        var plannedMinutes = stage.PlannedDurationMinutes;
        
        if (elapsed.TotalMinutes >= plannedMinutes)
        {
            var overrun = elapsed - TimeSpan.FromMinutes(plannedMinutes);
            return $"⚠️ Overrun by {(int)overrun.TotalMinutes}:{overrun.Seconds:D2}";
        }
        
        var remaining = TimeSpan.FromMinutes(plannedMinutes) - elapsed;
        return $"⏱️ {(int)remaining.TotalMinutes}:{remaining.Seconds:D2} remaining";
    }

    private int GetProgressPercentage(AgendaStage stage)
    {
        if (stage.StartedAt == null) return 0;
        var elapsed = (DateTime.UtcNow - stage.StartedAt.Value).TotalMinutes;
        var percentage = (int)((elapsed / stage.PlannedDurationMinutes) * 100);
        return Math.Min(percentage, 150);
    }

    private string GetProgressBarClass(AgendaStage stage)
    {
        var percentage = GetProgressPercentage(stage);
        return percentage > 100 ? "bg-danger" : "bg-success";
    }

    private string GetStageClass(AgendaStage stage)
    {
        return stage.Status switch
        {
            StageStatus.Active => "border-primary border-3",
            StageStatus.Completed => "border-success",
            _ => ""
        };
    }

    private int GetOverallProgress()
    {
        if (meeting == null || !meeting.Stages.Any()) return 0;
        var completed = meeting.Stages.Count(s => s.Status == StageStatus.Completed);
        return (int)((double)completed / meeting.Stages.Count * 100);
    }

    public async ValueTask DisposeAsync()
    {
        StopTickTimer();
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    // Welcome modal functionality
    private AttendeeWelcome? attendeeWelcome;
    
    // Message management
    private AttendeeMessages? attendeeMessages;

    private string GetAttendeeNumber()
    {
        // Extract a simple number from the session ID for display
        // This is just for display purposes to show attendee anonymity
        return Math.Abs(sessionId.GetHashCode() % 1000).ToString();
    }

    private async Task ShowWelcomeManually()
    {
        await JSRuntime.InvokeVoidAsync("onboardingHelper.resetTour", "attendee-tour-seen");
        if (attendeeWelcome != null)
        {
            await attendeeWelcome.ShowWelcome();
        }
    }
}
