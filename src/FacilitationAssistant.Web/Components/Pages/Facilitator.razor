    private async Task MoveStageUp(Guid stageId)
    {
        if (meeting == null) return;
        
        var stage = meeting.Stages.FirstOrDefault(s => s.Id == stageId);
        if (stage == null || stage.OrderIndex == 0) return;

        var command = new ReorderAgendaStagesCommand(meeting.Id, stageId, stage.OrderIndex - 1);
        await Mediator.Send(command);
        await LoadMeeting();
    }

    private async Task MoveStageDown(Guid stageId)
    {
        if (meeting == null) return;
        
        var stage = meeting.Stages.FirstOrDefault(s => s.Id == stageId);
        if (stage == null || stage.OrderIndex >= meeting.Stages.Count - 1) return;

        var command = new ReorderAgendaStagesCommand(meeting.Id, stageId, stage.OrderIndex + 1);
        await Mediator.Send(command);
        await LoadMeeting();
    }

    private void HandleDragStart(Guid stageId)
    {
        draggedStageId = stageId;
        dragOverIndex = null;
    }

    private void HandleDragOver(int targetOrderIndex)
    {
        dragOverIndex = targetOrderIndex;
    }

    private async Task HandleDrop(int targetOrderIndex)
    {
        if (draggedStageId == null || meeting == null)
        {
            draggedStageId = null;
            dragOverIndex = null;
            return;
        }

        var draggedStage = meeting.Stages.FirstOrDefault(s => s.Id == draggedStageId.Value);
        if (draggedStage == null || draggedStage.OrderIndex == targetOrderIndex)
        {
            draggedStageId = null;
            dragOverIndex = null;
            return;
        }

        // For active meetings: only NotStarted stages may be moved, and only
        // into positions that come after all already-started (Active/Completed) stages.
        if (meeting.Status == MeetingStatus.Active)
        {
            if (draggedStage.Status != StageStatus.NotStarted)
            {
                draggedStageId = null;
                dragOverIndex = null;
                return;
            }

            var maxStartedIndex = meeting.Stages
                .Where(s => s.Status != StageStatus.NotStarted)
                .Select(s => s.OrderIndex)
                .DefaultIfEmpty(-1)
                .Max();

            if (targetOrderIndex <= maxStartedIndex)
            {
                draggedStageId = null;
                dragOverIndex = null;
                return;
            }
        }

        var command = new ReorderAgendaStagesCommand(meeting.Id, draggedStageId.Value, targetOrderIndex);
        await Mediator.Send(command);
        await LoadMeeting();
        draggedStageId = null;
        dragOverIndex = null;
    }

