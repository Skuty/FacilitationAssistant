    private async Task RegenerateFacilitatorLink()
    {
        if (meeting == null) return;

        try
        {
            isRegeneratingLink = true;
            regenerationMessage = string.Empty;
            StateHasChanged();

            // Call the command to regenerate the token
            var newToken = await Mediator.Send(new RegenerateFacilitatorTokenCommand(meeting.FacilitatorToken));

            // Update the meeting object with the new token
            meeting.FacilitatorToken = newToken;
            
            // Hide the link for security and reset state
            facilitatorLinkRevealed = false;
            regenerationMessage = "✓ Facilitator link has been regenerated successfully! Old link is now invalid.";
            regenerationSuccess = true;
            
            // Auto-hide message after 5 seconds
            _ = Task.Delay(5000).ContinueWith(_ =>
            {
                regenerationMessage = string.Empty;
                InvokeAsync(StateHasChanged);
            });

            // Navigate to the new URL
            Navigation.NavigateTo($"/facilitator/{newToken}", forceLoad: true);
        }
        catch (Exception ex)
        {
            regenerationMessage = $"⚠️ Error regenerating link: {ex.Message}";
            regenerationSuccess = false;
        }
        finally
        {
            isRegeneratingLink = false;
            StateHasChanged();
        }
    }

