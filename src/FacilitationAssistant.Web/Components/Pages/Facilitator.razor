    private string GetElapsedTime()
    {
        if (meeting?.StartedAt == null) return "0:00";
        var elapsed = DateTime.UtcNow - meeting.StartedAt.Value;
        return $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:D2}";
    }

    private string GetStageElapsedTime(AgendaStage stage)
    {
        if (stage.StartedAt == null) return "0:00";
        var elapsed = DateTime.UtcNow - stage.StartedAt.Value;
        var minutes = (int)elapsed.TotalMinutes;
        var seconds = elapsed.Seconds;
        
        if (minutes >= stage.PlannedDurationMinutes)
        {
            var overrun = elapsed - TimeSpan.FromMinutes(stage.PlannedDurationMinutes);
            return $"⚠️ Overrun by {(int)overrun.TotalMinutes}:{overrun.Seconds:D2}";
        }
        
        var remaining = TimeSpan.FromMinutes(stage.PlannedDurationMinutes) - elapsed;
        return $"{(int)remaining.TotalMinutes}:{remaining.Seconds:D2} remaining";
    }

    private int GetProgressPercentage(AgendaStage stage)
    {
        if (stage.StartedAt == null) return 0;
        var elapsed = (DateTime.UtcNow - stage.StartedAt.Value).TotalMinutes;
        var percentage = (int)((elapsed / stage.PlannedDurationMinutes) * 100);
        return Math.Min(percentage, 150); // Cap at 150% for display
    }

    private string GetProgressBarClass(AgendaStage stage)
    {
        var percentage = GetProgressPercentage(stage);
        return percentage > 100 ? "bg-danger" : "bg-success";
    }

    private string GetStageClass(AgendaStage stage)
    {
        return stage.Status switch
        {
            StageStatus.Active => "border-primary",
            StageStatus.Completed => "border-success",
            _ => ""
        };
    }

    private string GetStatusBadgeClass(StageStatus status)
    {
        return status switch
        {
            StageStatus.Active => "bg-primary",
            StageStatus.Completed => "bg-success",
            StageStatus.Skipped => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }

    // Question management methods
    private void AddOption()
    {
        if (newQuestionOptions.Count < 10)
        {
            newQuestionOptions.Add("");
        }
    }

    private void RemoveOption(int index)
    {
        if (newQuestionOptions.Count > 2)
        {
            newQuestionOptions.RemoveAt(index);
        }
    }

    private async Task AddQuestion()
    {
        questionError = string.Empty;

        if (meeting == null) return;

        // Validation
        if (string.IsNullOrWhiteSpace(newQuestionText) || newQuestionText.Length < 10)
        {
            questionError = "Question text must be at least 10 characters.";
            return;
        }

        if (newQuestionType == QuestionAnswerType.SingleChoice || newQuestionType == QuestionAnswerType.MultipleChoice)
        {
            if (newQuestionOptions.Count < 2 || newQuestionOptions.Any(string.IsNullOrWhiteSpace))
            {
                questionError = "Please provide at least 2 non-empty options.";
                return;
            }
        }

        if (newQuestionType == QuestionAnswerType.Scale)
        {
            if (newScaleMax - newScaleMin < 1)
            {
                questionError = "Scale must have at least 2 points.";
                return;
            }
        }

        if (newQuestionTriggerType == QuestionTriggerType.StageStart && string.IsNullOrWhiteSpace(newQuestionAssociatedStageId))
        {
            questionError = "Please select a stage for stage-triggered questions.";
            return;
        }

        try
        {
            var options = (newQuestionType == QuestionAnswerType.SingleChoice || newQuestionType == QuestionAnswerType.MultipleChoice)
                ? newQuestionOptions.Where(o => !string.IsNullOrWhiteSpace(o)).ToList()
                : null;

            Guid? associatedStageId = null;
            if (newQuestionTriggerType == QuestionTriggerType.StageStart && !string.IsNullOrWhiteSpace(newQuestionAssociatedStageId))
            {
                associatedStageId = Guid.Parse(newQuestionAssociatedStageId);
            }

            var command = new CreateQuestionCommand(
                meeting.Id,
                newQuestionText,
                newQuestionType,
                newQuestionTriggerType,
                associatedStageId,
                newQuestionVisibility,
                options,
                newQuestionType == QuestionAnswerType.Scale ? newScaleMin : null,
                newQuestionType == QuestionAnswerType.Scale ? newScaleMax : null,
                newQuestionType == QuestionAnswerType.Scale ? newScaleMinLabel : null,
                newQuestionType == QuestionAnswerType.Scale ? newScaleMaxLabel : null,
                null, // MaxSelectableOptions - not implemented in basic version
                false // TriggerImmediately
            );

            await Mediator.Send(command);
            await LoadMeeting();

            // Reset form
            newQuestionText = string.Empty;
            newQuestionType = QuestionAnswerType.SingleChoice;
            newQuestionTriggerType = QuestionTriggerType.Manual;
            newQuestionVisibility = QuestionResultVisibility.FacilitatorOnly;
            newQuestionOptions = new() { "", "" };
            newScaleMin = 1;
            newScaleMax = 5;
            newScaleMinLabel = string.Empty;
            newScaleMaxLabel = string.Empty;
            newQuestionAssociatedStageId = null;
        }
        catch (Exception ex)
        {
            questionError = $"Error creating question: {ex.Message}";
        }
    }

    private async Task TriggerQuestion(Guid questionId)
    {
        await Mediator.Send(new TriggerQuestionCommand(questionId));
        await LoadMeeting();
    }

    private async Task CloseQuestion(Guid questionId)
    {
        await Mediator.Send(new CloseQuestionCommand(questionId));
        await LoadMeeting();
    }

