@page "/facilitator/{token}"
@rendermode InteractiveServer
@using FacilitationAssistant.Core.Entities
@using FacilitationAssistant.Core.Queries
@using FacilitationAssistant.Core.Commands
@using Mediator
@using Microsoft.AspNetCore.SignalR.Client
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Facilitator View - @(meeting?.Title ?? "Meeting")</PageTitle>

<a href="#main-content" class="skip-link">Skip to main content</a>

@* Name prompt – must be completed before accessing the meeting *@
@if (showNamePrompt)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); z-index: 10000;" role="dialog" aria-modal="true" aria-labelledby="facilitatorNameTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: linear-gradient(135deg, #4e54c8 0%, #5e17eb 100%); color: white; border: none;">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="facilitatorNameTitle">🎯 Welcome, Facilitator!</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Enter your name to proceed. You will be assigned a unique identifier to distinguish you from others with the same name.</p>
                    <div class="mb-3">
                        <label for="facilitatorNameInput" class="form-label fw-bold">Your Name</label>
                        <input id="facilitatorNameInput"
                               type="text"
                               class="form-control @(!string.IsNullOrEmpty(nameInputError) ? "is-invalid" : "")"
                               placeholder="e.g. Sarah"
                               @bind="nameInput"
                               @bind:event="oninput"
                               @onkeydown="OnNameKeyDown"
                               maxlength="30"
                               autofocus />
                        @if (!string.IsNullOrEmpty(nameInputError))
                        {
                            <div class="invalid-feedback d-block text-white fw-bold">@nameInputError</div>
                        }
                        <div class="form-text text-white-50 mt-1">@nameInput.Trim().Length / 30 characters</div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light btn-lg" @onclick="SubmitName">Enter Meeting</button>
                </div>
            </div>
        </div>
    </div>
}

@if (meeting == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading meeting...</p>
    </div>
}
else
{
    <div class="container-fluid">
        @* End Meeting Confirmation Dialog *@
        @if (showEndMeetingDialog)
        {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog" aria-labelledby="endMeetingTitle" aria-modal="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title" id="endMeetingTitle"><span aria-hidden="true">⚠️</span> End Meeting?</h5>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to end this meeting?</p>
                            <p class="mb-0"><strong>This will:</strong></p>
                            <ul>
                                <li>Stop all active stage timers</li>
                                <li>Finalize the meeting summary</li>
                                <li>Redirect all participants to the summary view</li>
                            </ul>
                            <p class="text-muted mb-0"><small>This action cannot be undone.</small></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelEndMeeting">Cancel</button>
                            <button type="button" class="btn btn-danger" @onclick="ConfirmEndMeeting">End Meeting</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Abandon Setup Confirmation Dialog *@
        @if (showAbandonSetupDialog)
        {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog" aria-labelledby="abandonSetupTitle" aria-modal="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-warning">
                            <h5 class="modal-title" id="abandonSetupTitle"><span aria-hidden="true">⚠️</span> Abandon Meeting Setup?</h5>
                        </div>
                        <div class="modal-body">
                            <p>You are currently setting up a meeting. If you leave now, the meeting will remain in setup state but any unsaved changes may be lost.</p>
                            <p class="mb-0">Are you sure you want to leave and create a new meeting?</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelAbandonSetup" autofocus>Stay on this page</button>
                            <button type="button" class="btn btn-warning" @onclick="ConfirmAbandonSetup">Leave and create new meeting</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Delete Note Confirmation Dialog *@
        @if (deletingNoteId.HasValue)
        {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog" aria-labelledby="deleteNoteTitle" aria-modal="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteNoteTitle"><span aria-hidden="true">🗑️</span> Delete Note</h5>
                            <button type="button" class="btn-close" @onclick="() => deletingNoteId = null" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete this note? This action cannot be undone.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="() => deletingNoteId = null">Cancel</button>
                            <button type="button" class="btn btn-danger" @onclick="() => DeleteNote(deletingNoteId.Value)">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-12 bg-primary text-white p-3" role="banner">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0"><span aria-hidden="true">🎯</span> @meeting.Title</h4>
                        <small>Facilitator View | <span aria-hidden="true">👤</span> @userIdentifier | Status: @meeting.Status</small>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-outline-light me-2" @onclick="() => showSettings = true" aria-label="Open settings"><span aria-hidden="true">⚙️</span></button>
                        <button class="btn btn-sm btn-outline-light me-2" @onclick="ShowTourManually" aria-label="Show facilitator tour"><span aria-hidden="true">❓</span></button>
                        @if (meeting.Status == MeetingStatus.Setup)
                        {
                            <button class="btn btn-light btn-sm me-2" @onclick="ShowLinks" id="share-links-btn" aria-label="Share meeting links"><span aria-hidden="true">📎</span> Share Links</button>
                            <button class="btn btn-success" @onclick="StartMeeting" disabled="@(!meeting.Stages.Any())" aria-label="Start meeting">
                                <span aria-hidden="true">▶️</span> Start Meeting
                            </button>
                        }
                        else if (meeting.Status == MeetingStatus.Active)
                        {
                            <span class="badge bg-light text-primary fs-6 me-2" aria-live="off" aria-label="Meeting elapsed time">
                                <span aria-hidden="true">⏱️</span> @GetElapsedTime()
                            </span>
                            <button class="btn btn-light btn-sm me-2" @onclick="ShowLinks" id="share-links-btn" aria-label="Share meeting links"><span aria-hidden="true">📎</span> Share Links</button>
                            <button class="btn btn-danger" @onclick="ShowEndMeetingConfirmation" aria-label="End meeting">
                                <span aria-hidden="true">⏹️</span> End Meeting
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (meeting.Status == MeetingStatus.Setup)
        {
            <div class="row mt-4">
                <div class="col-md-8" id="main-content" role="main">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5>Agenda Builder</h5>
                        </div>
                        <div class="card-body">
                            @if (!meeting.Stages.Any())
                            {
                                <div class="alert alert-info">
                                    Add at least one agenda stage to start the meeting.
                                </div>
                            }

                            @foreach (var stage in meeting.Stages.OrderBy(s => s.OrderIndex))
                            {
                                <div class="card mb-2 stage-drag-item @(dragOverIndex == stage.OrderIndex && draggedStageId != stage.Id ? "drag-over" : "") @(draggedStageId == stage.Id ? "drag-source" : "")"
                                     draggable="true"
                                     @ondragstart="() => HandleDragStart(stage.Id)"
                                     @ondragover:preventDefault="true"
                                     @ondragover="() => HandleDragOver(stage.OrderIndex)"
                                     @ondrop="() => HandleDrop(stage.OrderIndex)"
                                     @ondragend="HandleDragEnd">
                                    <div class="card-body">
                                        @if (editingStageId == stage.Id)
                                        {
                                            <h6 class="mb-2">Edit Stage @(stage.OrderIndex + 1)</h6>
                                            <div class="mb-2">
                                                <input type="text" class="form-control form-control-sm" placeholder="Stage name" @bind="editStageName" maxlength="100" />
                                            </div>
                                            <div class="mb-2">
                                                <textarea class="form-control form-control-sm" placeholder="Description (optional)" @bind="editStageDescription" rows="2" maxlength="500"></textarea>
                                            </div>
                                            <div class="mb-2">
                                                <input type="number" class="form-control form-control-sm" placeholder="Duration (minutes)" @bind="editStageDuration" min="1" max="240" />
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-primary btn-sm" @onclick="SaveEditStage">Save</button>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEditStage">Cancel</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="drag-handle me-2" title="Drag to reorder">⠿</div>
                                                <div class="flex-grow-1">
                                                    <h6>@(stage.OrderIndex + 1). @stage.Name</h6>
                                                    <small class="text-muted">Duration: @stage.PlannedDurationMinutes min</small>
                                                    @if (!string.IsNullOrEmpty(stage.Description))
                                                    {
                                                        <p class="mb-0 mt-2"><small>@stage.Description</small></p>
                                                    }
                                                </div>
                                                <div class="btn-group-vertical">
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            @onclick="() => StartEditStage(stage)"
                                                            title="Edit Stage">
                                                        ✏️
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary" 
                                                            @onclick="() => MoveStageUp(stage.Id)" 
                                                            disabled="@(stage.OrderIndex == 0)"
                                                            title="Move Up">
                                                        ▲
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary" 
                                                            @onclick="() => MoveStageDown(stage.Id)" 
                                                            disabled="@(stage.OrderIndex == meeting.Stages.Count - 1)"
                                                            title="Move Down">
                                                        ▼
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" 
                                                            @onclick="() => DeleteStage(stage.Id)"
                                                            title="Delete Stage">
                                                        🗑️
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (meeting.Stages.Any())
                            {
                                <div class="d-flex justify-content-end mt-1 mb-2">
                                    <small class="text-muted">Total planned time: <strong>@meeting.Stages.Sum(s => s.PlannedDurationMinutes) min</strong></small>
                                </div>
                            }

                            <div class="card mt-3">
                                <div class="card-body">
                                    <h6>Add New Stage</h6>
                                    <div class="mb-2">
                                        <input type="text" class="form-control" placeholder="Stage name" @bind="newStageName" maxlength="100" />
                                    </div>
                                    <div class="mb-2">
                                        <textarea class="form-control" placeholder="Description (optional)" @bind="newStageDescription" rows="2" maxlength="500"></textarea>
                                    </div>
                                    <div class="mb-2">
                                        <input type="number" class="form-control" placeholder="Duration (minutes)" @bind="newStageDuration" min="1" max="240" />
                                    </div>
                                    <button class="btn btn-primary btn-sm" @onclick="AddStage">Add Stage</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Question Management Section *@
                    <div class="card">
                        <div class="card-header">
                            <h5>📊 Questions & Polls</h5>
                        </div>
                        <div class="card-body">
                            @if (!questions.Any())
                            {
                                <div class="alert alert-info">
                                    Add questions to gather feedback from attendees during the meeting.
                                </div>
                            }

                            @foreach (var question in questions.OrderBy(q => q.CreatedAt))
                            {
                                <div class="card mb-2">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6>@question.Text</h6>
                                                <div class="d-flex gap-2 flex-wrap">
                                                    <span class="badge bg-secondary">@question.AnswerType</span>
                                                    <span class="badge bg-info">@question.TriggerType</span>
                                                    <span class="badge @GetQuestionStatusBadge(question.Status)">@question.Status</span>
                                                    @if (question.IsAdHoc)
                                                    {
                                                        <span class="badge bg-warning text-dark">Ad-hoc</span>
                                                    }
                                                </div>
                                                @if (question.IsAdHoc)
                                                {
                                                    <div class="mt-1">
                                                        <small class="text-muted">Created by <strong>@(question.AuthorName ?? "Facilitator")</strong> at @question.CreatedAt.ToLocalTime().ToString("HH:mm")</small>
                                                        @if (question.TriggeredAt.HasValue)
                                                        {
                                                            <small class="text-muted ms-2">· Triggered at @question.TriggeredAt.Value.ToLocalTime().ToString("HH:mm")</small>
                                                        }
                                                    </div>
                                                }
                                                @if (question.Options.Any())
                                                {
                                                    <div class="mt-2">
                                                        <small class="text-muted">Options: @string.Join(", ", question.Options.OrderBy(o => o.OrderIndex).Select(o => o.OptionText))</small>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="card mt-3">
                                <div class="card-body">
                                    <h6>Add New Question</h6>
                                    <div class="mb-2">
                                        <label class="form-label">Question Text</label>
                                        <input type="text" class="form-control" placeholder="Enter your question" @bind="newQuestionText" maxlength="300" />
                                        <small class="text-muted">@newQuestionText.Length/300 characters</small>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Answer Type</label>
                                        <select class="form-select" @bind="newQuestionType">
                                            <option value="@QuestionAnswerType.SingleChoice">Single Choice</option>
                                            <option value="@QuestionAnswerType.MultipleChoice">Multiple Choice</option>
                                            <option value="@QuestionAnswerType.FreeText">Free Text</option>
                                            <option value="@QuestionAnswerType.Scale">Scale</option>
                                        </select>
                                    </div>
                                    
                                    @if (newQuestionType == QuestionAnswerType.SingleChoice || newQuestionType == QuestionAnswerType.MultipleChoice)
                                    {
                                        <div class="mb-2">
                                            <label class="form-label">Options (@newQuestionOptions.Count/10)</label>
                                            @foreach (var (option, index) in newQuestionOptions.Select((o, i) => (o, i)))
                                            {
                                                <div class="input-group mb-1">
                                                    <input type="text" class="form-control" placeholder="Option @(index + 1)" @bind="newQuestionOptions[index]" maxlength="100" />
                                                    <button class="btn btn-outline-danger" @onclick="() => RemoveOption(index)">✕</button>
                                                </div>
                                            }
                                            <button class="btn btn-sm btn-outline-primary" @onclick="AddOption" disabled="@(newQuestionOptions.Count >= 10)">+ Add Option</button>
                                        </div>
                                    }

                                    @if (newQuestionType == QuestionAnswerType.Scale)
                                    {
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label class="form-label">Scale Min</label>
                                                <input type="number" class="form-control" @bind="newScaleMin" min="0" max="9" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Scale Max</label>
                                                <input type="number" class="form-control" @bind="newScaleMax" min="1" max="10" />
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <input type="text" class="form-control" placeholder="Min Label (optional)" @bind="newScaleMinLabel" maxlength="100" />
                                            </div>
                                            <div class="col-md-6">
                                                <input type="text" class="form-control" placeholder="Max Label (optional)" @bind="newScaleMaxLabel" maxlength="100" />
                                            </div>
                                        </div>
                                    }

                                    <div class="mb-2">
                                        <label class="form-label">Trigger Type</label>
                                        <select class="form-select" @bind="newQuestionTriggerType">
                                            <option value="@QuestionTriggerType.Manual">Manual (trigger when ready)</option>
                                            <option value="@QuestionTriggerType.MeetingStart">Automatically at meeting start</option>
                                            <option value="@QuestionTriggerType.StageStart">Automatically at stage start</option>
                                            <option value="@QuestionTriggerType.StageEnd">Automatically at stage end</option>
                                        </select>
                                    </div>

                                    @if ((newQuestionTriggerType == QuestionTriggerType.StageStart || newQuestionTriggerType == QuestionTriggerType.StageEnd) && meeting.Stages.Any())
                                    {
                                        <div class="mb-2">
                                            <label class="form-label">Associated Stage</label>
                                            <select class="form-select" @bind="newQuestionAssociatedStageId">
                                                <option value="">Select a stage...</option>
                                                @foreach (var stage in meeting.Stages.OrderBy(s => s.OrderIndex))
                                                {
                                                    <option value="@stage.Id">@(stage.OrderIndex + 1). @stage.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }

                                    <div class="mb-3">
                                        <label class="form-label">Result Visibility</label>
                                        <select class="form-select" @bind="newQuestionVisibility">
                                            <option value="@QuestionResultVisibility.FacilitatorOnly">Facilitator Only</option>
                                            <option value="@QuestionResultVisibility.AggregatedResultsToAttendees">Show Aggregated Results to Attendees</option>
                                            <option value="@QuestionResultVisibility.AllResponsesToAttendees">Show All Responses to Attendees</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="allowAnonymousCheck" @bind="newQuestionAllowAnonymousAnswers" />
                                            <label class="form-check-label" for="allowAnonymousCheck">
                                                Allow attendees to answer anonymously
                                            </label>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(questionError))
                                    {
                                        <div class="alert alert-danger">@questionError</div>
                                    }

                                    <button class="btn btn-primary btn-sm" @onclick="AddQuestion">Add Question</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    @if (showLinksPanel)
                    {
                        <div class="card">
                            <div class="card-header bg-warning">
                                <h6 class="mb-0">⚠️ Meeting Links</h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-danger">Facilitator Link (Keep Private!)</label>
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control font-monospace" readonly 
                                               value="@(facilitatorLinkRevealed ? GetFacilitatorUrl() : "••••••••••••••••••••••••••")" />
                                        <button class="btn btn-outline-secondary" @onclick="ToggleFacilitatorLinkVisibility">
                                            @(facilitatorLinkRevealed ? "🙈 Hide" : "👁️ Reveal")
                                        </button>
                                        <button class="btn btn-outline-primary" 
                                                @onclick="() => CopyToClipboard(GetFacilitatorUrl())"
                                                disabled="@(!facilitatorLinkRevealed)">
                                            Copy
                                        </button>
                                    </div>
                                    <button class="btn btn-sm btn-danger" @onclick="RegenerateFacilitatorLink" disabled="@isRegeneratingLink">
                                        @if (isRegeneratingLink)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        🔄 Regenerate Link
                                    </button>
                                    @if (!string.IsNullOrEmpty(regenerationMessage))
                                    {
                                        <div class="alert alert-@(regenerationSuccess ? "success" : "danger") alert-sm mt-2 mb-0" role="alert">
                                            @regenerationMessage
                                        </div>
                                    }
                                </div>
                                <div>
                                    <label class="form-label fw-bold">Attendee Link (Share This)</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" readonly value="@GetAttendeeUrl()" />
                                        <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboard(GetAttendeeUrl())">Copy</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (meeting.Status == MeetingStatus.Active)
        {
            <div class="row mt-4">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h5>Agenda Progress</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var stage in meeting.Stages.OrderBy(s => s.OrderIndex))
                            {
                                <div class="card mb-3 @GetStageClass(stage) @(stage.Status == StageStatus.NotStarted && dragOverIndex == stage.OrderIndex && draggedStageId != stage.Id ? "drag-over" : "") @(draggedStageId == stage.Id ? "drag-source" : "")"
                                     draggable="@(stage.Status == StageStatus.NotStarted ? "true" : "false")"
                                     @ondragstart="() => HandleDragStart(stage.Id)"
                                     @ondragover:preventDefault="true"
                                     @ondragover="() => HandleDragOver(stage.OrderIndex)"
                                     @ondrop="() => HandleDrop(stage.OrderIndex)"
                                     @ondragend="HandleDragEnd">
                                    <div class="card-body">
                                        @if (editingStageId == stage.Id)
                                        {
                                            <h6 class="mb-2">Edit Stage @(stage.OrderIndex + 1)</h6>
                                            <div class="mb-2">
                                                <input type="text" class="form-control form-control-sm" placeholder="Stage name" @bind="editStageName" maxlength="100" />
                                            </div>
                                            <div class="mb-2">
                                                <textarea class="form-control form-control-sm" placeholder="Description (optional)" @bind="editStageDescription" rows="2" maxlength="500"></textarea>
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label form-label-sm mb-1">Planned duration (minutes)</label>
                                                <input type="number" class="form-control form-control-sm" @bind="editStageDuration" min="1" max="240" />
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-primary btn-sm" @onclick="SaveEditStage">Save</button>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEditStage">Cancel</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-content-between align-items-start">
                                                @if (stage.Status == StageStatus.NotStarted)
                                                {
                                                    <div class="drag-handle me-2" title="Drag to reorder">⠿</div>
                                                }
                                                <div class="flex-grow-1">
                                                    <h6>@(stage.OrderIndex + 1). @stage.Name</h6>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge @GetStatusBadgeClass(stage.Status)">@stage.Status</span>
                                                        <small class="text-muted">Planned: @stage.PlannedDurationMinutes min</small>
                                                        @if (stage.Status == StageStatus.Active)
                                                        {
                                                            <span class="text-primary fw-bold">@GetStageElapsedTime(stage)</span>
                                                        }
                                                        @if (stage.Status == StageStatus.Completed)
                                                        {
                                                            <span class="text-success">Completed in @(stage.ActualDurationSeconds / 60) min</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(stage.Description))
                                                    {
                                                        <p class="mb-0 mt-1"><small class="text-muted">@stage.Description</small></p>
                                                    }
                                                    @if (stage.Status == StageStatus.Active)
                                                    {
                                                        <div class="progress mt-2" style="height: 20px;">
                                                            <div class="progress-bar @GetProgressBarClass(stage)" 
                                                                 style="width: @GetProgressPercentage(stage)%"
                                                                 role="progressbar"
                                                                 aria-valuenow="@GetProgressPercentage(stage)"
                                                                 aria-valuemin="0"
                                                                 aria-valuemax="100"
                                                                 aria-label="Stage progress: @GetProgressPercentage(stage) percent complete">
                                                                @GetProgressPercentage(stage)%
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="btn-group">
                                                    @if (stage.Status == StageStatus.NotStarted || stage.Status == StageStatus.Active)
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEditStage(stage)" title="Edit Stage">✏️</button>
                                                    }
                                                    @if (stage.Status == StageStatus.NotStarted)
                                                    {
                                                        <button class="btn btn-sm btn-outline-secondary"
                                                                @onclick="() => MoveStageUp(stage.Id)"
                                                                disabled="@(stage.OrderIndex == 0 || meeting.Stages.Any(s => s.OrderIndex == stage.OrderIndex - 1 && s.Status != StageStatus.NotStarted))"
                                                                title="Move Up">▲</button>
                                                        <button class="btn btn-sm btn-outline-secondary"
                                                                @onclick="() => MoveStageDown(stage.Id)"
                                                                disabled="@(stage.OrderIndex >= meeting.Stages.Count - 1)"
                                                                title="Move Down">▼</button>
                                                    }
                                                    @if (stage.Status == StageStatus.NotStarted || stage.Status == StageStatus.Completed)
                                                    {
                                                        <button class="btn btn-success btn-sm" @onclick="() => StartStage(stage.Id)">▶️ Start</button>
                                                    }
                                                    @if (stage.Status == StageStatus.Active)
                                                    {
                                                        <button class="btn btn-danger btn-sm" @onclick="() => EndStage(stage.Id)">⏹️ End</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    @if (showLinksPanel)
                    {
                        <div class="card mb-3">
                            <div class="card-header bg-warning">
                                <h6 class="mb-0">⚠️ Meeting Links</h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-danger">Facilitator Link (Keep Private!)</label>
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control font-monospace" readonly 
                                               value="@(facilitatorLinkRevealed ? GetFacilitatorUrl() : "••••••••••••••••••••••••••")" />
                                        <button class="btn btn-outline-secondary" @onclick="ToggleFacilitatorLinkVisibility">
                                            @(facilitatorLinkRevealed ? "🙈 Hide" : "👁️ Reveal")
                                        </button>
                                        <button class="btn btn-outline-primary" 
                                                @onclick="() => CopyToClipboard(GetFacilitatorUrl())"
                                                disabled="@(!facilitatorLinkRevealed)">
                                            Copy
                                        </button>
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label fw-bold">Attendee Link (Share This)</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" readonly value="@GetAttendeeUrl()" />
                                        <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboard(GetAttendeeUrl())">Copy</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">📊 Meeting Stats</h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Total Stages:</strong> @meeting.Stages.Count</p>
                            <p class="mb-1"><strong>Completed:</strong> @meeting.Stages.Count(s => s.Status == StageStatus.Completed)</p>
                            <p class="mb-1"><strong>Participants:</strong> @meeting.AttendeeSessions.Count (@meeting.AttendeeSessions.Count(s => s.IsConnected) online)</p>
                            <p class="mb-1"><strong>Notes:</strong> @meeting.Notes.Count(n => n.IsPublic)</p>
                            <p class="mb-0"><strong>Concerns:</strong> @concerns.Count(c => !c.IsWithdrawn)</p>
                        </div>
                    </div>

                    @* Participants Panel *@
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                👥 Participants
                                <span class="badge bg-success ms-1">@meeting.AttendeeSessions.Count(s => s.IsConnected) online</span>
                                @if (meeting.AttendeeSessions.Count(s => !s.IsConnected) > 0)
                                {
                                    <span class="badge bg-secondary ms-1">@meeting.AttendeeSessions.Count(s => !s.IsConnected) offline</span>
                                }
                            </h6>
                        </div>
                        @if (meeting.AttendeeSessions.Any())
                        {
                            <div class="card-body p-2" style="max-height: 250px; overflow-y: auto;">
                                <ul class="list-unstyled mb-0">
                                    @foreach (var session in meeting.AttendeeSessions.OrderByDescending(s => s.IsConnected).ThenBy(s => s.DisplayName ?? ""))
                                    {
                                        <li class="d-flex align-items-center py-1 px-1 border-bottom">
                                            <span class="me-2" style="font-size: 0.55rem; color: @(session.IsConnected ? "#28a745" : "#6c757d");" aria-hidden="true">⬤</span>
                                            <span class="flex-grow-1 @(session.IsConnected ? "" : "text-muted")">
                                                @if (!string.IsNullOrWhiteSpace(session.DisplayName))
                                                {
                                                    @session.DisplayName
                                                }
                                                else
                                                {
                                                    <em class="text-muted">Anonymous</em>
                                                }
                                            </span>
                                            <small class="text-muted ms-1" title="Joined at @session.JoinedAt.ToString("HH:mm")">@session.JoinedAt.ToString("HH:mm")</small>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="card-body">
                                <p class="text-muted mb-0"><small>No participants have joined yet.</small></p>
                            </div>
                        }
                    </div>

                    @if (concerns.Any())
                    {
                        <div class="card mb-3">
                            <div class="card-header bg-warning">
                                <h6 class="mb-0">💬 Concerns (@concerns.Count(c => !c.IsWithdrawn && !c.IsAcknowledged))</h6>
                            </div>
                            <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                                @foreach (var concern in concerns.OrderByDescending(c => !c.IsAcknowledged).ThenByDescending(c => c.CreatedAt))
                                {
                                    var likeCount = concern.Votes.Count(v => v.VoteType == VoteType.Like);
                                    var dislikeCount = concern.Votes.Count(v => v.VoteType == VoteType.Dislike);
                                    var neutralCount = concern.Votes.Count(v => v.VoteType == VoteType.Neutral);
                                    
                                    <div class="card mb-2 @(concern.IsWithdrawn ? "opacity-50" : "") @(concern.IsAcknowledged ? "" : "border-warning border-3")">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="flex-grow-1">
                                                    <h6>
                                                        @concern.ConcernType
                                                        @if (!concern.IsAcknowledged)
                                                        {
                                                            <span class="badge bg-danger ms-2">NEW</span>
                                                        }
                                                        @if (concern.IsAcknowledged)
                                                        {
                                                            <span class="badge bg-success ms-2">✓ Acknowledged</span>
                                                        }
                                                        @if (concern.IsWithdrawn)
                                                        {
                                                            <span class="badge bg-secondary ms-2">Withdrawn</span>
                                                        }
                                                    </h6>
                                                    @if (!string.IsNullOrEmpty(concern.CustomText))
                                                    {
                                                        <p class="mb-1">@concern.CustomText</p>
                                                    }
                                                    <div class="mb-2">
                                                        <span class="badge bg-primary me-1">👍 @likeCount</span>
                                                        <span class="badge bg-danger me-1">👎 @dislikeCount</span>
                                                        <span class="badge bg-secondary">😐 @neutralCount</span>
                                                    </div>
                                                    <small class="text-muted">Raised @GetTimeAgo(concern.CreatedAt)</small>
                                                </div>
                                                @if (!concern.IsAcknowledged && !concern.IsWithdrawn)
                                                {
                                                    <button class="btn btn-sm btn-success" @onclick="() => AcknowledgeConcern(concern.Id)">
                                                        ✓ Acknowledge
                                                    </button>
                                                }
                                            </div>
                                            
                                            @if (respondingToConcernId == concern.Id)
                                            {
                                                <div class="mt-2">
                                                    <textarea class="form-control mb-2" 
                                                              @bind="responseText" 
                                                              placeholder="Type your response (max 500 characters)..." 
                                                              rows="2" 
                                                              maxlength="500"></textarea>
                                                    <small class="text-muted d-block mb-2">@responseText.Length / 500</small>
                                                    <button class="btn btn-sm btn-primary me-1" @onclick="() => SendResponse(concern.Id)">
                                                        Send
                                                    </button>
                                                    <button class="btn btn-sm btn-secondary" @onclick="CancelResponse">
                                                        Cancel
                                                    </button>
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(concern.ResponseText))
                                            {
                                                <div class="alert alert-info mb-0 mt-2">
                                                    <strong>Your Response:</strong> @concern.ResponseText
                                                    @if (!concern.IsWithdrawn)
                                                    {
                                                        <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => EditResponse(concern.Id, concern.ResponseText)">
                                                            Edit
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (!concern.IsWithdrawn)
                                            {
                                                <button class="btn btn-sm btn-outline-primary mt-2" @onclick="() => StartResponse(concern.Id)">
                                                    💬 Respond
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Stage Proposals Panel *@
                    @if (meeting.StageProposals.Any())
                    {
                        var pendingProposals = meeting.StageProposals.Where(p => p.Status == StageProposalStatus.Pending).ToList();
                        <div class="card mb-3">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0">
                                    💡 Stage Proposals
                                    @if (pendingProposals.Any())
                                    {
                                        <span class="badge bg-warning text-dark ms-2">@pendingProposals.Count pending</span>
                                    }
                                </h6>
                            </div>
                            <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                                @foreach (var proposal in meeting.StageProposals.OrderByDescending(p => p.Status == StageProposalStatus.Pending).ThenByDescending(p => p.CreatedAt))
                                {
                                    <div class="card mb-2 @(proposal.Status == StageProposalStatus.Pending ? "border-info border-2" : "opacity-75")">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1">@proposal.Name</h6>
                                                    @if (!string.IsNullOrEmpty(proposal.ProposerName))
                                                    {
                                                        <small class="text-muted">Proposed by <strong>@proposal.ProposerName</strong></small>
                                                    }
                                                    @if (!string.IsNullOrEmpty(proposal.Description))
                                                    {
                                                        <p class="mb-1 mt-1"><small>@proposal.Description</small></p>
                                                    }
                                                    <small class="text-muted">⏱️ @proposal.PlannedDurationMinutes min</small>
                                                </div>
                                                @if (proposal.Status == StageProposalStatus.Pending)
                                                {
                                                    <span class="badge bg-secondary ms-2">Pending</span>
                                                }
                                                else if (proposal.Status == StageProposalStatus.Accepted)
                                                {
                                                    <span class="badge bg-success ms-2">✓ Accepted</span>
                                                }
                                                else if (proposal.Status == StageProposalStatus.Rejected)
                                                {
                                                    <span class="badge bg-danger ms-2">✗ Rejected</span>
                                                }
                                            </div>
                                            @if (proposal.Status == StageProposalStatus.Pending)
                                            {
                                                @if (rejectingProposalId == proposal.Id)
                                                {
                                                    <div class="mt-2">
                                                        <input type="text"
                                                               class="form-control form-control-sm mb-1"
                                                               placeholder="Rejection reason (optional)"
                                                               @bind="rejectReason"
                                                               maxlength="200" />
                                                        <div class="btn-group btn-group-sm">
                                                            <button class="btn btn-danger btn-sm" @onclick="() => RejectProposal(proposal.Id)">✗ Confirm Reject</button>
                                                            <button class="btn btn-secondary btn-sm" @onclick="() => rejectingProposalId = null">Cancel</button>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="btn-group btn-group-sm mt-2">
                                                        <button class="btn btn-success btn-sm" @onclick="() => AcceptProposal(proposal.Id)">✓ Accept</button>
                                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => { rejectingProposalId = proposal.Id; rejectReason = string.Empty; }">✗ Reject</button>
                                                    </div>
                                                }
                                            }
                                            @if (proposal.Status == StageProposalStatus.Rejected && !string.IsNullOrEmpty(proposal.RejectionReason))
                                            {
                                                <div class="alert alert-danger mb-0 mt-2 p-2">
                                                    <small><strong>Reason:</strong> @proposal.RejectionReason</small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Notes Section *@
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">📝 Notes (@meeting.Notes.Count)</h6>
                        </div>
                        <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                            <div class="mb-3">
                                <textarea class="form-control" 
                                          placeholder="Add a note..."
                                          @bind="newNoteContent"
                                          rows="3"
                                          maxlength="1000"></textarea>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="facilitatorNoteVisibilityCheck" @bind="newNoteIsPublic">
                                        <label class="form-check-label" for="facilitatorNoteVisibilityCheck">
                                            <small>👁️ Make note public (visible to attendees)</small>
                                        </label>
                                    </div>
                                    <button class="btn btn-primary btn-sm" @onclick="AddNote">Add Note</button>
                                </div>
                            </div>

                            @if (meeting.Notes.Any())
                            {
                                @foreach (var note in meeting.Notes.OrderByDescending(n => n.CreatedAt))
                                {
                                    var isOwnNote = note.SessionId == "facilitator";
                                    var isEditing = editingNoteId == note.Id;
                                    
                                    <div class="card mb-2 @(note.IsPublic ? "bg-light" : "bg-warning bg-opacity-10")">
                                        <div class="card-body p-2">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <div class="flex-grow-1">
                                                    @if (isEditing)
                                                    {
                                                        <textarea class="form-control form-control-sm mb-2" 
                                                                  @bind="editNoteContent"
                                                                  rows="3"
                                                                  maxlength="1000"></textarea>
                                                        <div class="btn-group btn-group-sm">
                                                            <button class="btn btn-success btn-sm" @onclick="SaveNoteEdit">💾 Save</button>
                                                            <button class="btn btn-secondary btn-sm" @onclick="CancelNoteEdit">Cancel</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-start gap-2">
                                                            <span>@(note.IsPublic ? "👁️" : "🔒")</span>
                                                            <div class="flex-grow-1">
                                                                <small class="d-block">@note.Content</small>
                                                                <small class="text-muted">
                                                                    @note.CreatedAt.ToString("HH:mm:ss")
                                                                    @if (note.UpdatedAt.HasValue)
                                                                    {
                                                                        <span> (edited)</span>
                                                                    }
                                                                    @if (isOwnNote)
                                                                    {
                                                                        <span class="badge bg-primary ms-1">@(note.AuthorName ?? "Facilitator")</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-secondary ms-1">@(note.AuthorName ?? "Attendee")</span>
                                                                    }
                                                                    @if (note.StageId != null)
                                                                    {
                                                                        var stage = meeting.Stages.FirstOrDefault(s => s.Id == note.StageId);
                                                                        if (stage != null)
                                                                        {
                                                                            <span class="badge bg-info ms-1">@stage.Name</span>
                                                                        }
                                                                    }
                                                                </small>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                @if (isOwnNote && !isEditing)
                                                {
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleNoteVisibility(note.Id, note.IsPublic)" title="Toggle visibility">
                                                            @(note.IsPublic ? "🔒" : "👁️")
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditNote(note.Id, note.Content)" title="Edit">✏️</button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteNote(note.Id)" title="Delete">🗑️</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">No notes yet.</p>
                            }
                        </div>
                    </div>

                    @* Questions Management *@
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">📊 Questions</h6>
                        </div>
                        <div class="card-body">
                            @if (!questions.Any())
                            {
                                <p class="text-muted">No questions added yet.</p>
                            }
                            else
                            {
                                @foreach (var question in questions.OrderBy(q => q.CreatedAt))
                                {
                                    var results = questionResults.ContainsKey(question.Id) ? questionResults[question.Id] : null;
                                    <div class="card mb-2">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="flex-grow-1">
                                                    <h6>@question.Text</h6>
                                                    <div class="d-flex gap-2 flex-wrap">
                                                        <span class="badge bg-secondary">@question.AnswerType</span>
                                                        <span class="badge @GetQuestionStatusBadge(question.Status)">@question.Status</span>
                                                        @if (question.IsAdHoc)
                                                        {
                                                            <span class="badge bg-warning text-dark">Ad-hoc</span>
                                                        }
                                                    </div>
                                                    @if (question.IsAdHoc)
                                                    {
                                                        <div class="mt-1">
                                                            <small class="text-muted">Created by <strong>@(question.AuthorName ?? "Facilitator")</strong> at @question.CreatedAt.ToLocalTime().ToString("HH:mm")</small>
                                                            @if (question.TriggeredAt.HasValue)
                                                            {
                                                                <small class="text-muted ms-2">· Triggered at @question.TriggeredAt.Value.ToLocalTime().ToString("HH:mm")</small>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="btn-group">
                                                    @if (question.Status == QuestionStatus.Draft)
                                                    {
                                                        <button class="btn btn-sm btn-success" @onclick="() => TriggerQuestion(question.Id)">
                                                            ▶️ Trigger
                                                        </button>
                                                    }
                                                    @if (question.Status == QuestionStatus.Active)
                                                    {
                                                        <button class="btn btn-sm btn-danger" @onclick="() => CloseQuestion(question.Id)">
                                                            ⏹️ Close
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            @if (results != null)
                                            {
                                                <div class="mt-2 p-2 bg-light rounded">
                                                    <small><strong>Responses:</strong> @results.TotalResponses | <strong>Skipped:</strong> @results.TotalSkipped | <strong>Pending:</strong> @results.TotalPending</small>
                                                    
                                                    @if (question.AnswerType == QuestionAnswerType.SingleChoice || question.AnswerType == QuestionAnswerType.MultipleChoice)
                                                    {
                                                        @if (results.ChoiceResults != null)
                                                        {
                                                            <div class="mt-2">
                                                                @foreach (var option in question.Options.OrderBy(o => o.OrderIndex))
                                                                {
                                                                    var count = results.ChoiceResults.ContainsKey(option.Id) ? results.ChoiceResults[option.Id] : 0;
                                                                    var percentage = results.TotalResponses > 0 ? (int)((count / (double)results.TotalResponses) * 100) : 0;
                                                                    <div class="mb-1">
                                                                        <small>@option.OptionText: @count (@percentage%)</small>
                                                                        <div class="progress" style="height: 15px;">
                                                                            <div class="progress-bar" 
                                                                                 style="width: @percentage%"
                                                                                 role="progressbar"
                                                                                 aria-valuenow="@percentage"
                                                                                 aria-valuemin="0"
                                                                                 aria-valuemax="100"
                                                                                 aria-label="@option.OptionText: @count responses, @percentage percent"></div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                    else if (question.AnswerType == QuestionAnswerType.Scale && results.ScaleResults != null)
                                                    {
                                                        <div class="mt-2">
                                                            <small><strong>Average:</strong> @results.ScaleResults.AverageScore.ToString("F1") out of @question.ScaleMax</small>
                                                            <div class="mt-2">
                                                                <small><strong>Distribution:</strong></small>
                                                                @foreach (var kvp in results.ScaleResults.Distribution.OrderBy(d => d.Key))
                                                                {
                                                                    var percentage = results.TotalResponses > 0 ? (int)((kvp.Value / (double)results.TotalResponses) * 100) : 0;
                                                                    <div class="mb-1">
                                                                        <small>@kvp.Key: @kvp.Value (@percentage%)</small>
                                                                        <div class="progress" style="height: 15px;">
                                                                            <div class="progress-bar bg-info" 
                                                                                 style="width: @percentage%"
                                                                                 role="progressbar"
                                                                                 aria-valuenow="@percentage"
                                                                                 aria-valuemin="0"
                                                                                 aria-valuemax="100"
                                                                                 aria-label="Scale value @kvp.Key: @kvp.Value responses, @percentage percent"></div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (question.AnswerType == QuestionAnswerType.FreeText && results.FreeTextAnswers != null)
                                                    {
                                                        <div class="mt-2">
                                                            <small><strong>Responses:</strong> @results.FreeTextAnswers.Count</small>
                                                            @if (results.FreeTextAnswers.Any())
                                                            {
                                                                <details class="mt-1">
                                                                    <summary class="btn btn-sm btn-link p-0">View responses</summary>
                                                                    <ul class="mt-1 mb-0">
                                                                        @foreach (var answer in results.FreeTextAnswers)
                                                                        {
                                                                            <li>
                                                                                <small>@answer.Answer</small>
                                                                                @if (!string.IsNullOrEmpty(answer.AuthorName))
                                                                                {
                                                                                    <span class="badge bg-secondary ms-2">@answer.AuthorName</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="badge bg-light text-muted ms-2">Anonymous</span>
