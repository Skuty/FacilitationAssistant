    private async Task AddQuestion()
    {
        questionError = string.Empty;

        if (meeting == null) return;

        // Validation
        if (string.IsNullOrWhiteSpace(newQuestionText) || newQuestionText.Length < 10)
        {
            questionError = "Question text must be at least 10 characters.";
            return;
        }

        if (newQuestionType == QuestionAnswerType.SingleChoice || newQuestionType == QuestionAnswerType.MultipleChoice)
        {
            if (newQuestionOptions.Count < 2 || newQuestionOptions.Any(string.IsNullOrWhiteSpace))
            {
                questionError = "Please provide at least 2 non-empty options.";
                return;
            }
        }

        if (newQuestionType == QuestionAnswerType.Scale)
        {
            if (newScaleMax - newScaleMin < 1)
            {
                questionError = "Scale must have at least 2 points.";
                return;
            }
        }

        if ((newQuestionTriggerType == QuestionTriggerType.StageStart || newQuestionTriggerType == QuestionTriggerType.StageEnd) && string.IsNullOrWhiteSpace(newQuestionAssociatedStageId))
        {
            questionError = "Please select a stage for stage-triggered questions.";
            return;
        }

        try
        {
            var options = (newQuestionType == QuestionAnswerType.SingleChoice || newQuestionType == QuestionAnswerType.MultipleChoice)
                ? newQuestionOptions.Where(o => !string.IsNullOrWhiteSpace(o)).ToList()
                : null;

            Guid? associatedStageId = null;
            if ((newQuestionTriggerType == QuestionTriggerType.StageStart || newQuestionTriggerType == QuestionTriggerType.StageEnd) && !string.IsNullOrWhiteSpace(newQuestionAssociatedStageId))
            {
                associatedStageId = Guid.Parse(newQuestionAssociatedStageId);
            }

            var command = new CreateQuestionCommand(
                meeting.Id,
                newQuestionText,
                newQuestionType,
                newQuestionTriggerType,
                associatedStageId,
                newQuestionVisibility,
                options,
                newQuestionType == QuestionAnswerType.Scale ? newScaleMin : null,
                newQuestionType == QuestionAnswerType.Scale ? newScaleMax : null,
                newQuestionType == QuestionAnswerType.Scale ? newScaleMinLabel : null,
                newQuestionType == QuestionAnswerType.Scale ? newScaleMaxLabel : null,
                null, // MaxSelectableOptions - not implemented in basic version
                false, // TriggerImmediately
                newQuestionAllowAnonymousAnswers,
                userIdentifier
            );

            await Mediator.Send(command);
            await LoadMeeting();

            // Reset form
            newQuestionText = string.Empty;
            newQuestionType = QuestionAnswerType.SingleChoice;
            newQuestionTriggerType = QuestionTriggerType.Manual;
            newQuestionVisibility = QuestionResultVisibility.FacilitatorOnly;
            newQuestionOptions = new() { "", "" };
            newScaleMin = 1;
            newScaleMax = 5;
            newScaleMinLabel = string.Empty;
            newScaleMaxLabel = string.Empty;
            newQuestionAssociatedStageId = null;
            newQuestionAllowAnonymousAnswers = false;
        }
        catch (Exception ex)
        {
            questionError = $"Error creating question: {ex.Message}";
        }
    }

