    protected override async Task OnInitializedAsync()
    {
        await LoadMeeting();
        
        // If meeting is ended, redirect to summary
        if (meeting?.Status == MeetingStatus.Ended)
        {
            Navigation.NavigateTo($"/summary/{Token}");
            return;
        }

        // Guard against accidentally navigating away during meeting setup
        _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
        
        // Setup SignalR connection
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/meetinghub"))
            .WithAutomaticReconnect()
            .Build();
        
        // Handle meeting updates
        _hubConnection.On<string>("MeetingUpdated", async (updateType) =>
        {
            await LoadMeeting();
            
            // Check if meeting ended
            if (meeting?.Status == MeetingStatus.Ended)
            {
                StopTickTimer();
                await InvokeAsync(() => Navigation.NavigateTo($"/summary/{Token}"));
                return;
            }

            // Refresh message manager on any message-related update
            if (messageManager != null)
                await InvokeAsync(messageManager.Refresh);

            // Start or stop the local tick timer based on whether a stage is active
            if (meeting?.Stages.Any(s => s.Status == StageStatus.Active) == true)
                StartTickTimer();
            else
                StopTickTimer();


            
            await InvokeAsync(StateHasChanged);
        });
        
        await _hubConnection.StartAsync();
        
        // Join meeting group
        if (meeting != null)
        {
            await _hubConnection.InvokeAsync("JoinMeeting", meeting.Id.ToString(), string.Empty);
        }

        // Start per-second tick if a stage is already active
        if (meeting?.Stages.Any(s => s.Status == StageStatus.Active) == true)
            StartTickTimer();
    }

    private async Task LoadMeeting()
    {
        var query = new GetMeetingByTokenQuery(Token, true);
        meeting = await Mediator.Send(query);

        if (meeting != null)
        {
            // Load questions
            var questionsQuery = new GetQuestionsByMeetingQuery(meeting.Id);
            questions = await Mediator.Send(questionsQuery);

            // Load results for active/closed questions
            foreach (var question in questions.Where(q => q.Status != QuestionStatus.Draft))
            {
                var resultsQuery = new GetQuestionResultsQuery(question.Id);
                var results = await Mediator.Send(resultsQuery);
                if (results != null)
                {
                    questionResults[question.Id] = results;
                }
            }
            
            // Load concerns
            await LoadConcerns();
        }
    }

    private async Task LoadConcerns()
    {
        if (meeting == null) return;
        
        var query = new GetConcernsByMeetingQuery(meeting.Id);
