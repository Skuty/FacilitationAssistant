    private async Task ShowTourManually()
    {
        await JSRuntime.InvokeVoidAsync("onboardingHelper.resetTour", "facilitator-tour-seen");
        if (tourOverlay != null)
        {
            await tourOverlay.ShowTour();
        }
    }

    private async Task RefreshMessages()
    {
        if (messageManager != null)
            await messageManager.Refresh();
        StateHasChanged();
    }

    private void SubmitName()
    {
        var trimmed = nameInput.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            nameInputError = "Please enter your name.";
            return;
        }
        if (trimmed.Length < 2)
        {
            nameInputError = "Name must be at least 2 characters.";
            return;
        }

        nameInputError = string.Empty;
        var suffix = Random.Shared.Next(1000, 10000);
        userIdentifier = $"{trimmed}-{suffix}";
        showNamePrompt = false;
    }

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SubmitName();
    }
}
