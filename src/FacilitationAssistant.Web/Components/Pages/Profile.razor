@page "/profile"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@using System.Text.Json
@using System.Text.Json.Serialization

<PageTitle>Profile</PageTitle>

<div class="container" style="max-width: 700px; margin-top: 2rem;">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">👤 Profile</h4>
            <a href="/" class="btn btn-outline-secondary btn-sm">← Back</a>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">
                Your display name is shown alongside your contributions in meetings (notes, concerns, poll answers).
                It is stored only in your browser's local storage.
            </p>

            <div class="mb-3">
                <label for="profileNameInput" class="form-label fw-bold">Display Name</label>
                <input id="profileNameInput"
                       type="text"
                       class="form-control @(!string.IsNullOrEmpty(validationError) ? "is-invalid" : "")"
                       placeholder="e.g. Michael"
                       @bind="nameInput"
                       @bind:event="oninput"
                       @onkeydown="OnKeyDown"
                       maxlength="30"
                       disabled="@isLoading" />
                @if (!string.IsNullOrEmpty(validationError))
                {
                    <div class="invalid-feedback d-block">@validationError</div>
                }
                <div class="form-text">@nameInput.Trim().Length / 30 characters</div>
            </div>

            @if (showSuccess)
            {
                <div class="alert alert-success py-2 mb-3" role="status">
                    ✅ Name saved successfully!
                </div>
            }

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveName" disabled="@isLoading">
                    💾 Save
                </button>
                @if (hasSavedName)
                {
                    <button class="btn btn-outline-danger" @onclick="ClearName" disabled="@isLoading">
                        🗑️ Clear saved name
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Meeting History -->
    <div class="card shadow-sm mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📋 Meeting History</h5>
            @if (meetingHistory.Count > 0)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="ClearHistory" disabled="@isLoading">
                    🗑️ Clear history
                </button>
            }
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="p-3 text-muted">Loading...</div>
            }
            else if (meetingHistory.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-1">No meetings in history yet.</p>
                    <small>Meetings you create or attend will appear here.</small>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Date</th>
                                <th>Role</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in meetingHistory)
                            {
                                <tr>
                                    <td class="align-middle">@(string.IsNullOrWhiteSpace(entry.Title) ? "(Untitled)" : entry.Title)</td>
                                    <td class="align-middle text-nowrap">
                                        <span title="@entry.CreatedAt">@FormatDate(entry.CreatedAt)</span>
                                    </td>
                                    <td class="align-middle">
                                        @if (entry.Role == "facilitator")
                                        {
                                            <span class="badge bg-primary">🎯 Facilitator</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">👥 Attendee</span>
                                        }
                                    </td>
                                    <td class="align-middle text-end">
                                        <a href="@GetMeetingUrl(entry)" class="btn btn-outline-secondary btn-sm">
                                            Open →
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private record MeetingHistoryEntry(
        [property: JsonPropertyName("id")] string Id,
        [property: JsonPropertyName("title")] string Title,
        [property: JsonPropertyName("createdAt")] string CreatedAt,
        [property: JsonPropertyName("role")] string Role,
        [property: JsonPropertyName("token")] string Token
    );

    private string nameInput = string.Empty;
    private string validationError = string.Empty;
    private bool showSuccess = false;
    private bool isLoading = true;
    private bool hasSavedName = false;
    private List<MeetingHistoryEntry> meetingHistory = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "author_name");
            if (!string.IsNullOrEmpty(saved))
            {
                nameInput = saved;
                hasSavedName = true;
            }

            await LoadHistory();

            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadHistory()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("eval",
                "JSON.stringify(window.meetingHistory ? window.meetingHistory.getHistory() : [])");
            if (!string.IsNullOrEmpty(json))
            {
                meetingHistory = JsonSerializer.Deserialize<List<MeetingHistoryEntry>>(json) ?? new();
            }
        }
        catch
        {
            meetingHistory = new();
        }
    }

    private async Task SaveName()
    {
        var trimmed = nameInput.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            validationError = "Please enter a name.";
            return;
        }
        if (trimmed.Length < 2)
        {
            validationError = "Name must be at least 2 characters.";
            return;
        }

        validationError = string.Empty;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "author_name", trimmed);
        nameInput = trimmed;
        hasSavedName = true;
        showSuccess = true;
        StateHasChanged();

        await Task.Delay(2500);
        showSuccess = false;
        StateHasChanged();
    }

    private async Task ClearName()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "author_name");
        nameInput = string.Empty;
        hasSavedName = false;
        validationError = string.Empty;
        StateHasChanged();
    }

    private async Task ClearHistory()
    {
        await JSRuntime.InvokeVoidAsync("meetingHistory.clearHistory");
        meetingHistory = new();
        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveName();
    }

    private string FormatDate(string isoDate)
    {
        if (DateTime.TryParse(isoDate, null, System.Globalization.DateTimeStyles.RoundtripKind, out var dt))
        {
            return dt.ToLocalTime().ToString("dd MMM yyyy HH:mm");
        }
        return isoDate;
    }

    private string GetMeetingUrl(MeetingHistoryEntry entry)
    {
        return entry.Role == "facilitator"
            ? $"/facilitator/{entry.Token}"
            : $"/attendee/{entry.Token}";
    }
}
