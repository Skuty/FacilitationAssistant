@using FacilitationAssistant.Core.Entities
@using FacilitationAssistant.Core.Commands
@using FacilitationAssistant.Core.Queries
@using Mediator
@inject IMediator Mediator

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">📩 Messages (@messages.Count)</h5>
        <button class="btn btn-sm btn-primary" @onclick="ShowComposer">+ Send Message</button>
    </div>
    <div class="card-body">
        @if (showComposer)
        {
            <div class="border rounded p-3 mb-3">
                <h6>Compose Message</h6>
                <div class="mb-3">
                    <label class="form-label">Message Text</label>
                    <textarea class="form-control" rows="3" maxlength="1000" @bind="messageText" placeholder="Enter message text (max 1000 characters)"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Message Type</label>
                    <select class="form-select" @bind="messageType">
                        <option value="@MessageType.Announcement">Announcement</option>
                        <option value="@MessageType.Question">Question</option>
                    </select>
                </div>
                @if (messageType == MessageType.Question)
                {
                    <div class="mb-3">
                        <label class="form-label">Response Type</label>
                        <select class="form-select" @bind="responseType">
                            <option value="">Select...</option>
                            <option value="@MessageResponseType.Reactions">Reactions (👍 👎 ❤️ 😂 😮)</option>
                            <option value="@MessageResponseType.PredefinedAnswers">Predefined Answers</option>
                            <option value="@MessageResponseType.FreeText">Free Text</option>
                        </select>
                    </div>
                    @if (responseType == MessageResponseType.PredefinedAnswers)
                    {
                        <div class="mb-3">
                            <label class="form-label">Answer Options (2-6 options)</label>
                            @foreach (var (option, index) in predefinedOptions.Select((o, i) => (o, i)))
                            {
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control" maxlength="100" @bind="predefinedOptions[index]" placeholder="Option @(index + 1)" />
                                    @if (predefinedOptions.Count > 2)
                                    {
                                        <button class="btn btn-outline-danger" @onclick="() => RemoveOption(index)">✖</button>
                                    }
                                </div>
                            }
                            @if (predefinedOptions.Count < 6)
                            {
                                <button class="btn btn-sm btn-secondary" @onclick="AddOption">+ Add Option</button>
                            }
                        </div>
                    }
                }
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SendMessage" disabled="@(!CanSendMessage())">Send</button>
                    <button class="btn btn-secondary" @onclick="CancelComposer">Cancel</button>
                </div>
            </div>
        }

        @if (messages.Any())
        {
            <div class="list-group">
                @foreach (var message in messages.OrderByDescending(m => m.CreatedAt))
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge @(message.Type == MessageType.Announcement ? "bg-info" : "bg-primary") me-2">
                                        @(message.Type == MessageType.Announcement ? "📢 Announcement" : "❓ Question")
                                    </span>
                                    <small class="text-muted">@message.CreatedAt.ToString("HH:mm")</small>
                                    @if (message.IsClosed)
                                    {
                                        <span class="badge bg-secondary ms-2">Closed</span>
                                    }
                                </div>
                                <p class="mb-2">@message.Text</p>
                                <small class="text-muted">@message.ResponseCount response@(message.ResponseCount == 1 ? "" : "s")</small>

                                @* Inline live response breakdown for question messages *@
                                @if (message.Type == MessageType.Question && messageDetailsMap.TryGetValue(message.Id, out var inlineDetail))
                                {
                                    @if (inlineDetail.Summary != null)
                                    {
                                        <div class="mt-2 p-2 bg-light rounded border">
                                            @if (inlineDetail.ResponseType == MessageResponseType.Reactions && inlineDetail.Summary.ReactionCounts != null && inlineDetail.Summary.ReactionCounts.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-3">
                                                    @foreach (var kvp in inlineDetail.Summary.ReactionCounts.OrderByDescending(k => k.Value))
                                                    {
                                                        var pct = inlineDetail.Summary.TotalResponses > 0 ? (int)((kvp.Value / (double)inlineDetail.Summary.TotalResponses) * 100) : 0;
                                                        <div class="text-center">
                                                            <div>@kvp.Key</div>
                                                            <div><small class="fw-bold">@kvp.Value</small> <small class="text-muted">(@pct%)</small></div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else if (inlineDetail.ResponseType == MessageResponseType.PredefinedAnswers && inlineDetail.Summary.OptionCounts != null)
                                            {
                                                @foreach (var option in inlineDetail.Options.OrderBy(o => o.OrderIndex))
                                                {
                                                    var cnt = inlineDetail.Summary.OptionCounts.ContainsKey(option.Id) ? inlineDetail.Summary.OptionCounts[option.Id] : 0;
                                                    var total = inlineDetail.Summary.TotalResponses;
                                                    var pct = total > 0 ? (int)((cnt / (double)total) * 100) : 0;
                                                    <div class="mb-1">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <small>@option.Text</small>
                                                            <small class="ms-2 text-nowrap">@cnt (@pct%)</small>
                                                        </div>
                                                        <div class="progress" style="height: 10px;">
                                                            <div class="progress-bar" style="width: @pct%" role="progressbar"
                                                                 aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"
                                                                 aria-label="@option.Text: @cnt responses, @pct percent"></div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else if (inlineDetail.ResponseType == MessageResponseType.FreeText && inlineDetail.Summary.FreeTextResponses != null && inlineDetail.Summary.FreeTextResponses.Any())
                                            {
                                                <details>
                                                    <summary><small>@inlineDetail.Summary.FreeTextResponses.Count free-text response@(inlineDetail.Summary.FreeTextResponses.Count == 1 ? "" : "s") — click to expand</small></summary>
                                                    <ul class="mt-1 mb-0 ps-3">
                                                        @foreach (var resp in inlineDetail.Summary.FreeTextResponses)
                                                        {
                                                            <li><small>@resp</small></li>
                                                        }
                                                    </ul>
                                                </details>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-1"><small class="text-muted fst-italic">No responses yet</small></div>
                                    }
                                }
                            </div>
                            <div>
                                @if (!message.IsClosed)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CloseMessage(message.Id)">Close</button>
                                }
                                <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => ViewMessageDetails(message.Id)">View</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted text-center mb-0">No messages sent yet</p>
        }
    </div>
</div>

@* Message Detail Modal *@
@if (showMessageDetailModal && selectedMessageDetail != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(selectedMessageDetail.Type == MessageType.Announcement ? "📢 Announcement" : "❓ Question") Details
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseMessageDetailModal"></button>
                </div>
                <div class="modal-body">
                    <p class="fw-bold">@selectedMessageDetail.Text</p>
                    <small class="text-muted">Sent at @selectedMessageDetail.CreatedAt.ToString("HH:mm") | @(selectedMessageDetail.IsClosed ? "Closed" : "Open")</small>

                    @if (selectedMessageDetail.Summary != null)
                    {
                        <div class="mt-3">
                            <h6>📊 Responses (@selectedMessageDetail.Summary.TotalResponses total)</h6>

                            @if (selectedMessageDetail.ResponseType == MessageResponseType.Reactions && selectedMessageDetail.Summary.ReactionCounts != null)
                            {
                                <div class="d-flex flex-wrap gap-3 mt-2">
                                    @foreach (var kvp in selectedMessageDetail.Summary.ReactionCounts.OrderByDescending(k => k.Value))
                                    {
                                        <div class="text-center">
                                            <div class="fs-4">@kvp.Key</div>
                                            <div class="badge bg-primary">@kvp.Value</div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (selectedMessageDetail.ResponseType == MessageResponseType.PredefinedAnswers && selectedMessageDetail.Summary.OptionCounts != null)
                            {
                                <div class="mt-2">
                                    @foreach (var option in selectedMessageDetail.Options.OrderBy(o => o.OrderIndex))
                                    {
                                        var count = selectedMessageDetail.Summary.OptionCounts.ContainsKey(option.Id) ? selectedMessageDetail.Summary.OptionCounts[option.Id] : 0;
                                        var total = selectedMessageDetail.Summary.TotalResponses;
                                        var percentage = total > 0 ? (int)((count / (double)total) * 100) : 0;
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between">
                                                <small>@option.Text</small>
                                                <small>@count (@percentage%)</small>
                                            </div>
                                            <div class="progress" style="height: 15px;">
                                                <div class="progress-bar" style="width: @percentage%" role="progressbar"
                                                     aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"
                                                     aria-label="@option.Text: @count responses, @percentage percent"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (selectedMessageDetail.ResponseType == MessageResponseType.FreeText && selectedMessageDetail.Summary.FreeTextResponses != null)
                            {
                                <ul class="mt-2">
                                    @foreach (var response in selectedMessageDetail.Summary.FreeTextResponses)
                                    {
                                        <li><small>@response</small></li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mt-3">No responses yet.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseMessageDetailModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid MeetingId { get; set; }
    [Parameter] public EventCallback OnMessageSent { get; set; }
    
    private List<MessageDto> messages = new();
    private Dictionary<Guid, MessageDetailDto> messageDetailsMap = new();
    private bool showComposer = false;
    private MessageDetailDto? selectedMessageDetail = null;
    private bool showMessageDetailModal = false;
    private string messageText = "";
    private MessageType messageType = MessageType.Announcement;
    private MessageResponseType? responseType = null;
    private List<string> predefinedOptions = new() { "", "" };

    protected override async Task OnInitializedAsync()
    {
        await LoadMessages();
    }

    private async Task LoadMessages()
    {
        messages = await Mediator.Send(new GetMessagesByMeetingQuery(MeetingId));

        // Load full details for question messages to show live breakdowns inline
        var newMap = new Dictionary<Guid, MessageDetailDto>();
        foreach (var msg in messages.Where(m => m.Type == MessageType.Question))
        {
            var detail = await Mediator.Send(new GetMessageByIdQuery(msg.Id));
            if (detail != null)
                newMap[msg.Id] = detail;
        }
        messageDetailsMap = newMap;
    }

    private void ShowComposer()
    {
        showComposer = true;
        messageText = "";
        messageType = MessageType.Announcement;
        responseType = null;
        predefinedOptions = new() { "", "" };
    }

    private void CancelComposer()
    {
        showComposer = false;
    }

    private void AddOption()
    {
        if (predefinedOptions.Count < 6)
        {
            predefinedOptions.Add("");
        }
    }

    private void RemoveOption(int index)
    {
        if (predefinedOptions.Count > 2)
        {
            predefinedOptions.RemoveAt(index);
        }
    }

    private bool CanSendMessage()
    {
        if (string.IsNullOrWhiteSpace(messageText)) return false;
        if (messageType == MessageType.Question && !responseType.HasValue) return false;
        if (responseType == MessageResponseType.PredefinedAnswers)
        {
            var validOptions = predefinedOptions.Where(o => !string.IsNullOrWhiteSpace(o)).ToList();
            if (validOptions.Count < 2) return false;
        }
        return true;
    }

    private async Task SendMessage()
    {
        try
        {
            var validOptions = responseType == MessageResponseType.PredefinedAnswers
                ? predefinedOptions.Where(o => !string.IsNullOrWhiteSpace(o)).ToList()
                : null;

            await Mediator.Send(new CreateMessageCommand(
                MeetingId,
                messageText,
                messageType,
                responseType,
                validOptions
            ));

            showComposer = false;
            await LoadMessages();
            await OnMessageSent.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending message: {ex.Message}");
        }
    }

    private async Task CloseMessage(Guid messageId)
    {
        try
        {
            await Mediator.Send(new CloseMessageCommand(messageId));
            await LoadMessages();
            await OnMessageSent.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error closing message: {ex.Message}");
        }
    }

    private async Task ViewMessageDetails(Guid messageId)
    {
        selectedMessageDetail = await Mediator.Send(new GetMessageByIdQuery(messageId));
        showMessageDetailModal = true;
    }

    private void CloseMessageDetailModal()
    {
        showMessageDetailModal = false;
        selectedMessageDetail = null;
    }

    public async Task Refresh()
    {
        await LoadMessages();
        StateHasChanged();
    }
}
